    "seed:refresh": "node --env-file-if-exists=.env --import tsx prisma/seed/demo.mts refresh",
    "seed:wipe": "node --env-file-if-exists=.env --import tsx prisma/seed/demo.mts wipe",
    "seed:status": "node --env-file-if-exists=.env --import tsx prisma/seed/status.mts",
