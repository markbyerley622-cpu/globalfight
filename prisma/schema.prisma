// ════════════════════════════════════════════════════════════════════════
//  Combat Reviews 2.0 — Prisma schema (PostgreSQL)
//  Designed for millions of records: indexed lookups, snapshot tables for
//  time-series ranking/odds data, and denormalised counters for hot reads.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Sport {
  BOXING
  MMA
  MUAY_THAI
  KICKBOXING
  K1
  BARE_KNUCKLE
  BJJ
  BJJ_NOGI
  WRESTLING
  JUDO
  TAEKWONDO
  SAMBO
  COMBAT_SAMBO
}

enum Stance {
  ORTHODOX
  SOUTHPAW
  SWITCH
}

/// The rules a BOUT was contested under — a first-class domain concept, not a
/// property of the card it sat on.
///
/// Event.sport was standing in for this and it is wrong for every multi-ruleset
/// promotion. A ONE numbered card runs MMA, Muay Thai, kickboxing and grappling
/// in one night; classifying the card by its majority (lib/scraper/ruleset)
/// gives a useful label for the EVENT and a false one for the individual bout.
/// The discipline audit proved the cost: it proposed reclassifying Superlek from
/// MUAY_THAI to MMA at confidence 1.00, because his bouts sit on MMA-labelled
/// cards.
///
/// Deliberately WIDER than Sport: SUBMISSION_GRAPPLING is a distinct ruleset
/// from BJJ (no gi, different scoring), and KARATE / LETHWEI / SANDA / SAVATE
/// exist here before any provider emits them so adding one is a mapping change
/// rather than a migration.
/// How much a fighter's stored discipline graph is worth. Persisted so a
/// consumer can decide whether to trust it WITHOUT re-deriving it — the whole
/// point of the persistence layer.
enum DisciplineTier {
  /// Backed by bouts whose ruleset the SOURCE stated per bout.
  HIGH
  /// Backed by bouts whose ruleset came from a single-ruleset promotion or the
  /// event's sport. Sound, a step removed from the bout.
  MEDIUM
  /// No usable bout evidence — the provider's import label is all there is.
  LOW
  /// Not even a label. Nothing is claimed.
  UNKNOWN
}

enum Ruleset {
  MMA
  BOXING
  MUAY_THAI
  KICKBOXING
  BJJ
  SUBMISSION_GRAPPLING
  WRESTLING
  JUDO
  SAMBO
  COMBAT_SAMBO
  TAEKWONDO
  BARE_KNUCKLE
  KARATE
  LETHWEI
  SANDA
  SAVATE
  /// We do not know. NEVER a guess — an honest gap a later backfill can fill.
  UNKNOWN
}

enum FightResult {
  WIN
  LOSS
  DRAW
  NO_CONTEST
  SCHEDULED
}

enum FightMethod {
  KO
  TKO
  UD // unanimous decision
  SD // split decision
  MD // majority decision
  SUB // submission (MMA)
  DQ
  RTD // retired
  TD // technical decision
  NC
  DRAW
}

enum RankMovement {
  UP
  DOWN
  SAME
  NEW
  RETURN
}

enum SanctioningBody {
  WBA
  WBC
  IBF
  WBO
  RING // Ring Magazine
  IBO
  THE_RING
  UNDISPUTED
  BKFC // Bare Knuckle Fighting Championship (promotion-as-sanctioning-body)
  ONE // ONE Championship (promotion-as-sanctioning-body)
  PFL // Professional Fighters League (promotion-as-sanctioning-body)
  UFC // Ultimate Fighting Championship (promotion-as-sanctioning-body)
  BELLATOR // Now a PFL brand, but its titles are still lineally its own
  GLORY // GLORY Kickboxing
  RIZIN // RIZIN Fighting Federation
  KSW
}

enum EventStatus {
  /// Admin-only. Never appears on any public surface, in search, or in the
  /// sitemap. Scraped events are never DRAFT — this is only for cards an
  /// operator is building by hand before announcing them.
  DRAFT
  ANNOUNCED
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PredictionSource {
  AI
  EXPERT
  COMMUNITY
}

enum UserRole {
  USER
  EXPERT
  EDITOR
  MODERATOR
  ADMIN
}

enum ScrapeStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// ─── Reference data ─────────────────────────────────────────────────────

model WeightClass {
  id       String @id @default(cuid())
  name     String // "Heavyweight" — unique per sport, not globally
  slug     String @unique // "heavyweight", "bk-heavyweight"
  sport    Sport  @default(BOXING)
  limitLbs Float? // 200, 175, 147...
  limitKg  Float?
  order    Int // display order, heaviest = 0

  rankings  Ranking[]
  champions Champion[]
  fights    Fight[]

  rankingObservations  RankingObservation[]
  championObservations ChampionObservation[]
  titleReigns          TitleReign[]

  @@unique([sport, name]) // names repeat across sports (Heavyweight in boxing AND bare-knuckle)
  @@index([sport, order])
}

model Language {
  id         String  @id @default(cuid())
  code       String  @unique // "en", "es", "fr"...
  name       String // "English"
  nativeName String // "English", "Español"
  rtl        Boolean @default(false)
  enabled    Boolean @default(true)
}

// ─── Fighters ───────────────────────────────────────────────────────────

model Fighter {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  nickname String?
  /// LEGACY: the provider's import label, and the display default. Kept in sync
  /// with `primarySport` during the migration so existing readers do not break,
  /// but it is NOT authoritative — new code reads primarySport/sports.
  sport    Sport   @default(BOXING)

  /// ── The canonical discipline graph ───────────────────────────────────────
  /// COMPUTED from Fight.ruleset via lib/fighters/disciplines, never imported.
  /// Every value here must be reproducible from bout history; if it cannot be
  /// reproduced it is a bug, not a fact.
  ///
  /// Persisted rather than derived on demand because the alternative is
  /// resolving disciplines for every row of every directory, ranking and search
  /// page — N+1 over a fighter's whole bout history, per request.
  ///
  /// The primary discipline. Null when there is no evidence AND no label.
  primarySport         Sport?
  /// EVERY discipline with bout evidence, primary first. A fighter is not one
  /// sport: Superlek fights Muay Thai and kickboxing, and the single `sport`
  /// column above can only ever be right about one of them.
  sports               Sport[]
  /// 0–1: the share of settled bouts sitting in the primary discipline. A pure
  /// specialist scores 1; a genuine crossover athlete scores lower, which is
  /// correct — the PRIMARY is less certain for them.
  disciplineConfidence Float?
  /// How much the above is worth, from the ruleset confidence of the bouts
  /// behind it. Stored so a consumer never has to re-derive to find out.
  disciplineTier       DisciplineTier?
  /// MACHINE-READABLE provenance, not a sentence:
  ///   [{ "sport": "MUAY_THAI", "settled": 12, "booked": 1, "source": "competition" }, …]
  /// So a profile can say "12 Muay Thai bouts, 5 kickboxing" without touching
  /// the Fight table, and an audit can prove the stored graph from its evidence.
  disciplineEvidence   Json?
  /// When the graph was last computed. A fighter whose bouts changed since is
  /// stale and is what the incremental recalculation selects on.
  lastCalculatedAt     DateTime?

  // bio
  nationality String? // ISO-ish country name
  countryCode String? // "US", "GB", "MX"
  birthDate   DateTime?
  birthPlace  String?
  residence   String?
  heightCm    Int?
  reachCm     Int?
  stance      Stance?
  debutDate   DateTime?
  gym         String?
  promoter    String?

  // self-service ownership — set when a user signs up as a fighter or claims
  // an existing profile. One user owns at most one fighter profile.
  ownerId      String? @unique
  owner        User?   @relation("FighterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  claimed      Boolean @default(false)
  website      String?
  instagram    String?
  twitter      String?
  contactEmail String? // public booking/contact email
  tagline      String? // hero strapline on their site
  profileKind  String  @default("fighter") // fighter | ring_girl | ring_official …
  beltRank     String? // BJJ / No-Gi
  style        String? // wrestling
  federation   String? // taekwondo
  rank         String? // judo / taekwondo

  // record (denormalised for fast reads — derived from Fight rows)
  wins        Int @default(0)
  losses      Int @default(0)
  draws       Int @default(0)
  noContests  Int @default(0)
  koWins      Int @default(0)
  koLosses    Int @default(0)
  totalRounds Int @default(0)

  // media (our own cached/processed images — never hotlinked source URLs)
  thumbUrl     String? // square ~160px (cards, rankings, search)
  imageUrl     String? // square ~512px (profile)
  heroImageUrl String? // 16:9 ~1280px (profile hero)

  // Licensed external photo (Wikimedia Commons). Displayed via the /api/img
  // proxy with the credit rendered on the profile — a source URL we hold an
  // attribution licence for, kept separate from the own-storage fields above.
  // ── Media provenance for the OWN-STORAGE images above ───────────────────
  // thumbUrl/imageUrl/heroImageUrl are our own processed copies. These record
  // where the bytes came from and what we knew about them, so a refresh can be
  // conditional (ETag / Last-Modified), a re-run can be a no-op (contentHash),
  // and a better source can never be overwritten by a worse one (imageTier).
  //
  // The source URL is stored as PROVENANCE, never rendered — nothing hotlinks it.
  imageTier         String? // "manual" | "official" | "wikimedia" | "espn"
  imageSource       String? // provider key that supplied it, e.g. "espn"
  imageSourceUrl    String? // exact URL the bytes were fetched from
  imageETag         String?
  imageLastModified String?
  imageContentHash  String? // sha256 of the SOURCE bytes — the idempotency key
  imageFetchedAt    DateTime?
  imageWidth        Int?
  imageHeight       Int?
  imageMimeType     String?
  /// Last time a provider had nothing for this fighter (404). Drives the
  /// monthly retry backoff — a miss is remembered so it is not re-asked daily.
  imageMissingAt    DateTime?
  imageMissReason   String?
  imageAttempts     Int       @default(0)

  photoUrl        String? // source image URL (upload.wikimedia.org/…)
  photoSource     String? // "Wikimedia Commons"
  photoCredit     String? // author / "Artist" from the file metadata
  photoLicense    String? // e.g. "CC BY-SA 4.0"
  photoLicenseUrl String? // link to the licence deed

  // meta
  active               Boolean   @default(true)
  bio                  String?   @db.Text
  lastScrapedAt        DateTime? // any scrape touched the row
  lastProfileScrapedAt DateTime? // profile-enrichment (photo/bio) last run
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // NOTE: provenance scalars (primarySource/sourceConfidence/sourceUpdatedAt)
  // are intentionally NOT on the model yet — they'd be auto-selected by every
  // fighter query and 500 until the column exists in prod. They get added in a
  // coordinated `db:push` when persistAggregated (services/sync/run.ts) lands.

  rankings         Ranking[]
  championOf       Champion[]
  fightsAsRed      Fight[]              @relation("RedCorner")
  fightsAsBlue     Fight[]              @relation("BlueCorner")
  titles           Title[]
  rankHistory      RankSnapshot[]
  // ── The evidence layer (see the Observation models) ──────────────────────
  rankingObservations  RankingObservation[]
  championObservations ChampionObservation[]
  titleReigns          TitleReign[]
  /// Open "is this the same person?" questions where THIS row is the subject.
  identityCandidates   FighterIdentityCandidate[] @relation("IdentityCandidateSubject")
  /// …and where this row is the possible match.
  identityMatches      FighterIdentityCandidate[] @relation("IdentityCandidateMatch")
  predictions      Prediction[]         @relation("PredictedWinner")
  favoritedBy      FavoriteFighter[]
  cardAwards       CardAward[]
  achievements     FighterAchievement[]
  sponsors         FighterSponsor[]
  socials          FighterSocial[]
  media            FighterMedia[]
  claims           FighterClaim[]
  externalIds      FighterExternalId[]
  aliases          FighterAlias[]
  discussionThread ForumThread?

  @@index([sport, active])
  /// The query every discipline-aware directory, filter and ranking will run:
  /// "fighters who compete in X". A Postgres GIN index is what makes an array
  /// `has` predicate a lookup rather than a table scan over 10k rows.
  @@index([sports], type: Gin)
  @@index([primarySport, active])
  /// The incremental recalculation's selector: whose graph is stale?
  @@index([lastCalculatedAt])
  @@index([countryCode])
  @@index([name])
  @@index([wins, losses])
  @@index([lastProfileScrapedAt]) // stale-profile detection for the enrichment queue
}

model Title {
  id        String          @id @default(cuid())
  fighterId String
  fighter   Fighter         @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  body      SanctioningBody
  weight    String // weight-class name at time of title
  wonDate   DateTime?
  lostDate  DateTime?
  current   Boolean         @default(false)

  @@index([fighterId])
  @@index([body, current])
}

// ─── Fighter-owned website content (managed by the profile owner) ────────

model FighterAchievement {
  id        String   @id @default(cuid())
  fighterId String
  fighter   Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  title     String
  year      Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fighterId, order])
}

model FighterSponsor {
  id        String  @id @default(cuid())
  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  name      String
  url       String?
  logoUrl   String?
  order     Int     @default(0)

  @@index([fighterId, order])
}

model FighterSocial {
  id        String  @id @default(cuid())
  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  platform  String // instagram | twitter | youtube | tiktok | facebook | web
  url       String

  @@unique([fighterId, platform])
}

model FighterMedia {
  id        String   @id @default(cuid())
  fighterId String
  fighter   Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  type      String // "photo" | "video"
  url       String // stored image URL or video (YouTube/Vimeo) URL
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fighterId, type, order])
}

// ─── Profile claiming & moderation ───────────────────────────────────────

model FighterClaim {
  id           String  @id @default(cuid())
  fighterId    String
  fighter      Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  claimantId   String
  claimant     User    @relation("ClaimsMade", fields: [claimantId], references: [id], onDelete: Cascade)
  status       String  @default("PENDING") // PENDING | APPROVED | REJECTED | INFO_REQUESTED
  evidenceType String? // website | social | email | id_document
  evidenceNote String? @db.Text

  // ── Identity evidence (passport / licence / ID card) ──────────────────────
  // Highly sensitive. Stored PRIVATE — never a public URL, never under public/.
  // We persist an opaque storage key, not a fetchable address; the bytes are
  // reachable only through an authorized, audited, streaming endpoint.
  evidenceStorageKey      String? // opaque object key; never returned to clients
  evidenceStorageProvider String? // "r2" | "blob" | "local-private"
  evidenceUploadedAt      DateTime?
  evidenceDeleteAfter     DateTime? // retention deadline; cleanup job deletes past this
  evidenceDeletedAt       DateTime?
  evidenceDeletionStatus  String? // null | PENDING | DELETED | FAILED
  evidenceDeletionError   String? // last failure reason (never the key/URL)
  evidenceScanStatus      String? // PENDING | CLEAN | INFECTED | SKIPPED
  evidenceContentType     String?
  evidenceByteSize        Int?

  /// DEPRECATED — legacy public URL from the pre-remediation implementation.
  /// Mapped to the original `evidenceUrl` column so no data is lost on db push.
  /// Nothing writes this. `scripts/remediate-claim-evidence.ts` reads it to
  /// delete the underlying public objects, then nulls it. Dropped in phase 2
  /// once every row is null (see docs/SECURITY-IDENTITY-EVIDENCE.md).
  legacyEvidenceUrl String? @map("evidenceUrl")

  reviewerId String?
  reviewer   User?     @relation("ClaimsReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@unique([fighterId, claimantId]) // one claim per user per fighter
  @@index([status, createdAt])
  @@index([fighterId])
  @@index([evidenceDeleteAfter]) // cleanup job scans this
  @@index([evidenceDeletionStatus]) // retry scan for FAILED deletions
}

/// A value an importer WANTED to write but could not, because an operator holds
/// that field.
///
/// Without this the two systems just diverge in silence: the importer stops
/// mattering and the operator never learns the source disagrees. Recording the
/// rejected value turns a silent overwrite-prevention into a reviewable
/// decision — accept the import, or keep the manual edit.
///
/// One row per (entity, field): only the LATEST proposal is worth reviewing, so
/// a re-run replaces rather than accumulates.
model ImportConflict {
  id            String    @id @default(cuid())
  entity        String // "Event" | "Fight"
  entityId      String
  field         String
  /// What the operator's value was when the conflict was recorded.
  currentValue  String?   @db.Text
  /// What the importer proposed instead.
  importedValue String?   @db.Text
  source        String? // provider that proposed it
  resolvedAt    DateTime?
  resolution    String? // "accepted" | "kept"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([entity, entityId, field])
  @@index([entityId, resolvedAt])
  @@index([resolvedAt])
}

/// Manual identity verification for professional registry roles.
///
/// Deliberately NOT a signup gate. An account exists and works the moment
/// someone registers; this runs afterwards and only gates the verified badge
/// and professional privileges. Gating registration on a human review queue
/// means abandoning every signup that arrives while the queue is asleep.
///
/// Submissions are never deleted — a declined attempt stays as history so a
/// pattern of resubmissions is visible to the next reviewer. The DOCUMENTS are
/// deleted on the retention schedule (see IdentityDocument); the decision
/// record outlives them, which is the right way round.
model IdentityVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("IdentityVerifications", fields: [userId], references: [id], onDelete: Cascade)

  /// The registry role AT SUBMISSION. Snapshotted rather than read live: a
  /// reviewer approving "coach" must not have that decision silently re-pointed
  /// at "promoter" because the user edited their profile mid-review.
  role String

  /// PENDING | APPROVED | DECLINED | RESUBMIT_REQUESTED
  status String @default("PENDING")

  /// Which attempt this is for the user, 1-based. Cheap to read, and it is the
  /// number a reviewer actually wants ("this is their 4th try").
  attempt Int @default(1)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  reviewerId  String?
  reviewer    User?     @relation("IdentityVerificationsReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)

  /// Shown to the user. Kept separate from reviewNote so an internal note can
  /// never be leaked by a careless select.
  declineReason String? @db.Text
  /// Staff-only. Never returned by any user-facing endpoint.
  reviewNote    String? @db.Text

  documents IdentityDocument[]

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

/// One uploaded document belonging to a verification request.
///
/// A child table rather than front/back/supporting columns on the parent: the
/// per-object bookkeeping the private store requires (provider, scan status,
/// content type, size, retention deadline, deletion outcome) is seven fields,
/// and three inline copies of it is twenty-one columns that the cleanup job
/// would then have to unroll by hand. This way retention iterates one table.
model IdentityDocument {
  id             String               @id @default(cuid())
  verificationId String
  verification   IdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  /// FRONT | BACK | SUPPORTING
  kind String

  /// Opaque object key — never a fetchable address, never returned to a client.
  storageKey      String
  storageProvider String
  contentType     String
  byteSize        Int
  /// PENDING | CLEAN | INFECTED | SKIPPED. Anything but CLEAN refuses to stream.
  scanStatus      String   @default("PENDING")
  uploadedAt      DateTime @default(now())

  /// Retention. The cleanup job deletes bytes past this deadline and records
  /// the outcome; the parent decision row survives.
  deleteAfter     DateTime?
  deletedAt       DateTime?
  deletionStatus  String? // null | PENDING | DELETED | FAILED
  deletionError   String? // last failure reason — never the key or a URL

  @@index([verificationId])
  @@index([deleteAfter])
  @@index([deletionStatus])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // user who performed the action
  action    String // "claim.create" | "claim.approve" | …
  entity    String // "FighterClaim" | "Fighter"
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Rankings (current snapshot, fast read) ─────────────────────────────

model Ranking {
  id            String      @id @default(cuid())
  weightClassId String
  weightClass   WeightClass @relation(fields: [weightClassId], references: [id], onDelete: Cascade)
  fighterId     String
  fighter       Fighter     @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  isPoundForPound Boolean      @default(false)
  rank            Int
  previousRank    Int?
  movement        RankMovement @default(SAME)
  rating          Float? // 0–100 point score
  source          String       @default("import")
  updatedAt       DateTime     @updatedAt
  /// WHY this rank: for generated P4P, the record/rating math behind the
  /// number ({ wins, losses, koWins, fightsCounted, rating }); for a curated
  /// connector, whatever it published (a source URL, a division standing).
  /// Never free text — always the machine-readable numbers/refs a consumer
  /// or an auditor could recompute the rank from.
  evidence        Json?

  /// WHOSE ranking this is: "UFC", "ONE", "PFL", "BKFC", "GLORY", "WBA"…
  /// Empty string = a cross-promotional list that belongs to the sport rather
  /// than to any one organisation (the curated P4P lists are these).
  ///
  /// Empty string rather than NULL is deliberate: Postgres treats NULLs as
  /// DISTINCT in a unique constraint, so a nullable column here would let the
  /// same fighter be inserted into the same division without limit — the exact
  /// duplicate the constraint exists to prevent.
  ///
  /// KNOWN LIMIT, recorded rather than hidden: WeightClass is keyed by (sport,
  /// name), so UFC Lightweight and ONE Lightweight share one row even though
  /// ONE's limit is 170lb and the UFC's is 155lb. Filtering by organisation
  /// still returns the right PEOPLE in the right ORDER — the divisional weight
  /// shown alongside is the sport's, not the promotion's. Per-promotion weight
  /// limits need WeightClass keyed by organisation too; that is a follow-up.
  organisation String @default("")

  // ── Reconciliation provenance ────────────────────────────────────────────
  // Ranking is now a PROJECTION of RankingObservation, not a place providers
  // write to. These columns are what make a published number explainable: which
  // provider won, at what tier, from which URL, effective when, and which
  // observations were behind it.
  //
  // `source` above is kept and still carries the winning provider id, so every
  // existing reader keeps working unchanged during the migration.
  /// Trust tier of the provider that decided this row.
  tier            String?
  /// "male" | "female", carried from the winning observation. See the note on
  /// RankingObservation.gender.
  gender          String?
  /// The source's own publication date for the winning observation.
  effectiveDate   DateTime?
  sourceUrl       String?
  /// 0..1, from the winning provider's tier.
  confidence      Float?
  /// How many DISTINCT providers agreed on this exact rank. 1 = a single source
  /// said it; 3 = three independent sources did, which is a different thing to
  /// show a reader.
  agreementCount  Int      @default(1)
  /// True when providers disagreed and the tier order broke the tie. Feeds the
  /// admin conflict view — a conflict that is invisible cannot be fixed.
  contested       Boolean  @default(false)
  /// The RankingObservation ids this row was computed from.
  observationIds  String[]
  /// When the reconciler last recomputed this row (distinct from updatedAt,
  /// which moves on any write).
  reconciledAt    DateTime?

  @@unique([weightClassId, isPoundForPound, fighterId, organisation])
  @@index([weightClassId, rank])
  @@index([isPoundForPound, rank])
  @@index([organisation, isPoundForPound, rank])
  /// The admin conflict view reads contested rows first.
  @@index([contested, reconciledAt])
}

/// Append-only history for Ranking. `Ranking` itself is the current board —
/// a write to it overwrites the row, so there was never anywhere to ask "what
/// was #1 last week." This is that: one row captured per fighter every time a
/// board is (re)generated or synced, never updated, never deleted by normal
/// operation. Keyed loosely (no FK to Ranking, which churns) rather than
/// tightly, so a fighter's snapshot history survives their current Ranking
/// row being deleted and recreated by the next generation pass.
/// Article-level twin of FeedView (video). Without this, the Following feed's
/// coverage band and Corner Men were a bare `ORDER BY publishedAt DESC LIMIT N`
/// re-run on every visit — if nothing new had published, a user saw the exact
/// same "3-day-old article" every time, because nothing on the read side knew
/// they had already been shown it. See lib/following.ts `unseenFirstArticles`.
model ArticleView {
  key       String
  articleId String
  viewedAt  DateTime @default(now())

  @@id([key, articleId])
}

model RankingSnapshot {
  id              String   @id @default(cuid())
  weightClassId   String
  fighterId       String
  isPoundForPound Boolean
  organisation    String   @default("")
  rank            Int
  rating          Float?
  source          String
  evidence        Json?
  capturedAt      DateTime @default(now())

  @@index([weightClassId, isPoundForPound, organisation, fighterId, capturedAt])
  @@index([fighterId, capturedAt])
}

// Time-series history — append-only, designed for millions of rows.
model RankSnapshot {
  id              String   @id @default(cuid())
  fighterId       String
  fighter         Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  weightClass     String // denormalised string key
  isPoundForPound Boolean  @default(false)
  rank            Int
  rating          Float?
  capturedAt      DateTime @default(now())

  @@index([fighterId, capturedAt])
  @@index([weightClass, capturedAt])
}

// ─── Champions ──────────────────────────────────────────────────────────

model Champion {
  id            String          @id @default(cuid())
  fighterId     String
  fighter       Fighter         @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  weightClassId String
  weightClass   WeightClass     @relation(fields: [weightClassId], references: [id], onDelete: Cascade)
  body          SanctioningBody
  beltImageUrl  String?
  since         DateTime?
  defenses      Int             @default(0)
  current       Boolean         @default(true)

  @@unique([weightClassId, body, current])
  @@index([body])
}

// ─── Events & Fights ────────────────────────────────────────────────────

/// Who authored an event row.
///
/// Not cosmetic. A PROMOTER event is authored by the people staging it — they
/// are the source, not a provider — so the dedupe engine must never merge one
/// into a scraped row, and the ingest pipeline must not treat a missing field
/// as something to go and fill in. `lockedFields` protects individual columns
/// (see lib/promoter/locking); this says what KIND of row it is, which is the
/// question a merge asks before it looks at any column.
enum EventSource {
  INGESTED
  PROMOTER
}

model Event {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  /// Defaults to INGESTED so every existing row keeps its current meaning
  /// without a backfill.
  source           EventSource @default(INGESTED)
  /// The organisation hosting this, when a verified promoter created it.
  promoterOrgId    String?
  promoterOrg      PromoterOrg? @relation(fields: [promoterOrgId], references: [id], onDelete: SetNull)
  sport            Sport       @default(BOXING)
  promotion        String?
  promotionId      String? // registry promotion (identity resolution)
  promotionRef     Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  venue            String?
  city             String?
  country          String?
  countryCode      String?
  broadcaster      String?
  posterUrl        String?
  /// 16:9 artwork for the event hero. Distinct from posterUrl (the vertical
  /// promotional poster) — different aspect, different placement.
  heroUrl          String?
  description      String?     @db.Text
  /// IANA zone for the venue, e.g. "Asia/Bangkok". `date` stays absolute UTC;
  /// this only tells the UI which local wall-clock the card is billed at.
  timezone         String?
  eventUrl         String?
  ticketUrl        String?
  date             DateTime
  /// Broadcast block starts. Null means "derive it" (see lib/card-segments) —
  /// an operator filling these in is what turns an estimate into a fact.
  broadcastStartAt DateTime?
  prelimStartAt    DateTime?
  mainCardStartAt  DateTime?
  status           EventStatus @default(SCHEDULED)

  /// Field-level provenance. Any column an operator has edited is listed here,
  /// and the ingest pipeline refuses to overwrite it (services/sync/persist).
  ///
  /// Without this the editor is decorative: the scrapers re-run on cron and
  /// unconditionally rewrite name/date/venue/status, so every manual correction
  /// would silently revert within hours. Locking is per FIELD, not per row, so
  /// a human fixing a venue never freezes the automatic result updates.
  lockedFields String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // provenance scalars deferred — see the note on the Fighter model.

  /// ── Results-ingestion bookkeeping ────────────────────────────────────────
  /// When the results harvester last ATTEMPTED this event, how many times it has,
  /// and how the last attempt ended (a WikiTargetOutcome.reason: "no_candidate",
  /// "all_rejected", "no_card", "unverified", "error", "verified").
  ///
  /// These exist to fix a starvation bug and a blindness, both of which produced the
  /// same symptom — "some events resolve, some stay Pending forever":
  ///
  ///  1. The hourly job selected `orderBy: date desc, take: RESULT_BATCH` over a
  ///     21-day window. With more than RESULT_BATCH (12) unresolved events in that
  ///     window it re-attempted the same 12 NEWEST every hour, while the 13th-oldest
  ///     onward were never attempted at all — and then aged out of the window
  ///     permanently, unreachable except by a manual `--historical` run. Which
  ///     events resolved was decided purely by queue position. Ordering by
  ///     `resultAttemptAt` nulls-first makes the queue a rotation instead: nothing
  ///     can be starved, and a repeatedly-failing event drifts to the back rather
  ///     than consuming the whole batch forever.
  ///
  ///  2. The harvester computes a precise per-event reason and then throws it away —
  ///     runner.ts logged `outcomes: undefined`, so production knew that 3 events
  ///     failed with "no_candidate" but never WHICH 3. Persisting the reason turns
  ///     "why is this event still pending" into one query.
  resultAttemptAt     DateTime?
  resultAttempts      Int       @default(0)
  resultAttemptReason String?
  /// Set when this card is KNOWN COMPLETE: it is in the past, it has at least one
  /// bout, and not one of them is still SCHEDULED. Cleared automatically if a
  /// pending bout ever reappears (a card gains a late addition, an operator
  /// un-decides a result), so it is a cache of a derivable fact and never a claim
  /// that outlives its evidence.
  ///
  /// The results cron skips these outright. Without it the hourly job re-queries
  /// every completed card in history forever, and the only thing that grows is
  /// someone else's bandwidth bill.
  resultsCompleteAt   DateTime?
  /// Why this card can never reach resultsCompleteAt, when that is the case.
  ///
  /// THREE states, not two, and conflating them loses real information:
  ///   resultsCompleteAt set                  -> COMPLETE. Every bout decided.
  ///   both null                              -> INCOMPLETE. Still queueable; a
  ///                                             revisitable source may yet say more.
  ///   this set, resultsCompleteAt null       -> TERMINAL. The only source that
  ///                                             covers it is a one-shot import and
  ///                                             it published no outcome for these
  ///                                             bouts. Nothing more is coming.
  ///
  /// A taekwondo bracket with two walkovers is TERMINAL, not incomplete: the
  /// walkover has no winner upstream either. Reporting it as incomplete makes a
  /// 100%-ingested sport read as 19% and hides the cards that are genuinely behind.
  resultsTerminalReason String?
  /// Percentage of this card's bouts the last attempt actually reconstructed.
  ///
  /// Added after the pipeline was found reporting "verified" for a 13-bout card from
  /// which it had harvested ONE bout (taken off a fighter's biography rather than the
  /// season page). The written result was correct, but the completeness claim was
  /// not — so completeness is now measured and stored rather than assumed.
  resultCoverage      Int?

  fights           Fight[]
  externalIds      EventExternalId[]
  discussionThread ForumThread?
  followers        FavoriteEvent[]
  checkIns         CheckIn[]

  @@index([date, status])
  /// The results-harvest queue: least-recently-attempted first. Without this the
  /// rotation above is a sort over every past event on every hourly tick.
  @@index([resultAttemptAt])
  /// The completed-card filter, which is the first clause the queue applies.
  @@index([resultsCompleteAt])
  @@index([country])
  @@index([promotion])
  @@index([promotionId])
  // Country filter + facet group in events-query.ts filter on countryCode; the
  // existing @@index([country]) is the wrong column for those queries.
  @@index([countryCode])
}

model Fight {
  id      String  @id @default(cuid())
  slug    String  @unique
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Restrict, NOT Cascade: a Fight is shared history between two fighters, so
  // deleting one corner must never silently erase the bout (which would also
  // wipe it from the opponent's record and cascade into picks/battles/odds).
  // A merge/cleanup must re-point redId/blueId first; the DB refuses the delete
  // until it does. There are no fighter.delete call sites today.
  redId  String
  red    Fighter @relation("RedCorner", fields: [redId], references: [id], onDelete: Restrict)
  blueId String
  blue   Fighter @relation("BlueCorner", fields: [blueId], references: [id], onDelete: Restrict)

  weightClassId String?
  weightClass   WeightClass? @relation(fields: [weightClassId], references: [id], onDelete: SetNull)

  scheduledRounds  Int       @default(12)
  titleFight       Boolean   @default(false)
  /// An interim belt. Separate from titleFight so the badge can read "Interim
  /// Title" — conflating them loses information a fan cares about.
  interimTitle     Boolean   @default(false)
  mainEvent        Boolean   @default(false)
  coMain           Boolean   @default(false)
  orderOnCard      Int       @default(0)
  /// Post-fight awards, entered by an operator after the card.
  performanceBonus Boolean   @default(false)
  fightOfTheNight  Boolean   @default(false)
  /// Explicit walkout time. Null means the schedule estimates it.
  estimatedStartAt DateTime?
  /// See Event.lockedFields. Critical here: the ingest pipeline rewrites
  /// orderOnCard from the SOURCE's index on every run, so drag-and-drop
  /// ordering would be destroyed by the next cron without this.
  lockedFields     String[]
  /// Which broadcast block this bout sits in: "MAIN" | "PRELIM" | "EARLY_PRELIM".
  /// Only set when a provider actually tells us. When null the schedule DERIVES a
  /// split from card size and bout order and labels it as an estimate — we never
  /// present a guessed broadcast block as fact.
  cardSegment      String?
  /// A bout pulled from the card (injury, weight miss, withdrawal). Kept rather
  /// than deleted so the change is visible to a fan who already made a pick.
  cancelled        Boolean   @default(false)
  /// Free-text note for a scratched or reshuffled bout, e.g. "Jones out (injury)
  /// — replaced by Silva". Rendered verbatim next to the bout.
  cardNote         String?

  /// ── The bout's own ruleset ──────────────────────────────────────────────
  /// Authoritative for fighter discipline. Event.sport is contextual metadata
  /// about the CARD and must not be used to classify a fighter.
  ///
  /// Defaults to UNKNOWN rather than to the event's sport: a wrong ruleset is
  /// indistinguishable from a right one downstream, and UNKNOWN is a gap a
  /// backfill can close without having to detect and undo a guess first.
  ruleset           Ruleset  @default(UNKNOWN)
  /// 0–1. How much the source told us, not how much we inferred: a ruleset
  /// stated per bout ("Featherweight Muay Thai") is 1; one derived from a
  /// single-ruleset promotion is lower; a guess is not stored at all.
  rulesetConfidence Float?
  /// Which provider/derivation set it, so a better source can supersede a weaker
  /// one and a bad backfill can be identified and re-run.
  rulesetSource     String?
  rulesetUpdatedAt  DateTime?

  // result
  result     FightResult  @default(SCHEDULED)
  winnerId   String? // Fighter.id or null
  method     FightMethod?
  roundEnded Int?
  timeEnded  String?
  scorecards Json? // [{judge, red, blue}]

  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions     Prediction[]
  odds            OddsSnapshot[]
  picks           FightPick[]
  battles         Battle[]
  /// The bout's PUBLIC community room — every fight is its own arena.
  room            ForumThread?
  // Set once by the resolution engine after a decided bout's picks are graded
  // and consequences fanned out — the idempotency guard so it never double-awards.
  picksResolvedAt DateTime?
  /// Provenance: which provider wrote this bout, from which page. See FightImport.
  imports         FightImport[]
  /// Results Intelligence: what sources SAID, and the one scored reading derived
  /// from them. Neither writes `result` — only a VERIFIED candidate does.
  resultEvidence  ResultEvidence[]
  resultCandidate ResultCandidate?

  @@index([date, result])
  /// "Which disciplines does this fighter compete in?" scans a fighter's bouts
  /// by ruleset — the query behind every directory, filter and ranking once
  /// discipline is derived from bouts rather than from the event.
  @@index([ruleset])
  @@index([redId])
  @@index([blueId])
  @@index([eventId, orderOnCard])
  // resolveDuePicks cron: WHERE result != SCHEDULED AND picksResolvedAt IS NULL.
  // The [date, result] index is date-leading and cannot serve this predicate.
  @@index([result, picksResolvedAt])
  // return-engine cron: recently-created fights in a 48h window.
  @@index([createdAt])
}

/// A signed-in user's pick on a single bout — the crowd-prediction primitive and
/// the North Star (WAPU) driver. One pick per user per fight (upserted). `corner`
/// is "RED" | "BLUE" (resolved against winningCorner() at fight time, not a
/// fighter FK, so it survives roster edits). `confidence` is an optional 1–5
/// star. `correct` is set by a future resolution pass to power accuracy /
/// credibility / streaks / collectible rewards — the fields the plan's habit
/// loop is built on. Distinct from CommunityMarket/Vote (generic open-ended
/// polls) and the dead editorial Prediction model.
model FightPick {
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fightId    String
  fight      Fight        @relation(fields: [fightId], references: [id], onDelete: Cascade)
  corner     String // "RED" | "BLUE"
  method     FightMethod?
  confidence Int? // 1..5
  correct    Boolean? // set when the bout resolves
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@id([userId, fightId])
  @@index([fightId, corner])
  // WAPU (weekly-active-predicting-users), the North-Star metric: metrics.ts
  // scans picks by updatedAt window with distinct userId — full scan without this.
  @@index([updatedAt])
}

// ─── Predictions ────────────────────────────────────────────────────────

model Prediction {
  id       String           @id @default(cuid())
  fightId  String
  fight    Fight            @relation(fields: [fightId], references: [id], onDelete: Cascade)
  source   PredictionSource
  authorId String? // User.id for expert/community
  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  predictedWinnerId String?
  predictedWinner   Fighter? @relation("PredictedWinner", fields: [predictedWinnerId], references: [id], onDelete: SetNull)

  redProbability   Float // 0..1
  blueProbability  Float
  methodPrediction FightMethod?
  roundPrediction  Int?
  confidence       Float?
  rationale        String?      @db.Text
  createdAt        DateTime     @default(now())

  @@index([fightId, source])
  @@index([authorId])
}

// ─── Betting intelligence (NO wagering) ─────────────────────────────────

model OddsSnapshot {
  id          String   @id @default(cuid())
  fightId     String
  fight       Fight    @relation(fields: [fightId], references: [id], onDelete: Cascade)
  bookmaker   String
  redOdds     Float // decimal odds
  blueOdds    Float
  drawOdds    Float?
  redImplied  Float // implied probability 0..1
  blueImplied Float
  capturedAt  DateTime @default(now())

  @@index([fightId, capturedAt])
  @@index([bookmaker])
}

// ─── News / CMS ─────────────────────────────────────────────────────────

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String?
  content       String        @db.Text
  category      String // "Breaking News", "Analysis"...
  status        ArticleStatus @default(DRAFT)
  featured      Boolean       @default(false)
  coverImageUrl String?
  sourceUrl     String? // original article URL (RSS link) — cards link out to it
  promotionId   String? // registry promotion this story is about (identity resolution)
  promotion     Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags ArticleTag[]

  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([featured])
  @@index([promotionId, publishedAt])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ─── Forums ─────────────────────────────────────────────────────────────

// A ForumCategory doubles as a Community: the official ones are seeded
// (MMA, Boxing, BJJ…) and user-created communities are added as rows with an
// ownerId. Membership lives in CommunityMember; avatar/banner/memberCount are
// the community-presentation fields.
model ForumCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  order       Int     @default(0)
  icon        String?
  avatarUrl   String?
  bannerUrl   String?
  memberCount Int     @default(0)

  // ── Fight clubs ────────────────────────────────────────────────────────
  // A fight club IS a community that happens to meet somewhere. Rather than
  // add a parallel FightClub model with its own membership, posts and
  // moderation — three systems to keep in sync forever — a community with
  // coordinates is a fight club. Everything it already has (threads, members,
  // roles, clips) comes along for free, and `kind` is the only branch.
  /// forum | fight_club
  kind        String  @default("forum")
  city        String?
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?
  /// When they train together — "Open sparring, Saturdays 11am".
  meetsOn     String?

  threads ForumThread[]
  members CommunityMember[]

  @@index([kind])
}

// One row per member of a community (a ForumCategory). role carries the
// owner/moderator flags used by later phases; Phase 1 only writes "member".
model CommunityMember {
  id          String        @id @default(cuid())
  communityId String
  community   ForumCategory @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String        @default("member") // member | moderator | owner
  createdAt   DateTime      @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model ForumThread {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  categoryId    String
  category      ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pinned        Boolean       @default(false)
  locked        Boolean       @default(false)
  // discussion | fighter_post | promoter_post | announcement — drives feed
  // treatment (fighter/promoter updates surface in the community feed).
  kind          String        @default("discussion")
  views         Int           @default(0)
  replyCount    Int           @default(0)
  // Denormalised engagement counters for fast trending/feed sorts (no joins).
  shareCount    Int           @default(0)
  reactionCount Int           @default(0) // sum of reactions across the thread's posts
  // When set, this thread is the discussion for a Combat Feed video. SetNull so
  // the discussion survives if the underlying feed video is pruned.
  videoId       String?
  video         FeedVideo?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  // Entity-linked auto-threads: every fighter/promotion gets ONE discussion
  // thread (1:1, provisioned on demand). promotion is a registry slug
  // (resolvePromotion), not an FK.
  fighterId     String?       @unique
  fighter       Fighter?      @relation(fields: [fighterId], references: [id], onDelete: SetNull)
  promotion     String?       @unique
  /// The event's GENERAL room — card-wide talk that belongs to no single bout
  /// ("who's watching?", "card is running late"). The third room in the
  /// hierarchy, NOT a competitor to the fight rooms:
  ///   Event → General room
  ///   Event → Fight → Battle room + Community room
  eventId       String?       @unique
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // ─── Rooms ────────────────────────────────────────────────────────────────
  // The Battle-Rooms architecture. Every FIGHT owns exactly one PUBLIC community
  // room (fightId) — the spectator layer. Every BATTLE owns exactly one PRIVATE
  // room (battleId, visibility="battle") readable and postable only by its two
  // participants. Both are ordinary ForumThreads: same posts, reactions, quotes,
  // realtime and moderation — no parallel discussion system.
  fightId    String? @unique
  fight      Fight?  @relation(fields: [fightId], references: [id], onDelete: SetNull)
  battleId   String? @unique
  battle     Battle? @relation(fields: [battleId], references: [id], onDelete: Cascade)
  /// "public" — listed in feeds/categories, world-readable.
  /// "battle"  — hidden from every listing, gated to the battle's two users.
  visibility String  @default("public")

  lastPostAt DateTime @default(now())
  createdAt  DateTime @default(now())

  posts         ForumPost[]
  subscriptions ForumSubscription[]
  bookmarks     ForumBookmark[]

  @@index([categoryId, lastPostAt])
  @@index([pinned, lastPostAt])
  @@index([kind, createdAt])
  @@index([videoId])
  @@index([createdAt])
  @@index([visibility, lastPostAt])
  // Forum feed "most-discussed" / "most-liked" order by these counters.
  @@index([replyCount])
  @@index([reactionCount])
}

model ForumPost {
  id            String      @id @default(cuid())
  threadId      String
  thread        ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  likeCount     Int         @default(0) // legacy "like" count (kept in sync)
  // Embedded/uploaded media: JSON array of
  //   { type: "image"|"youtube"|"instagram"|"x"|"tiktok"|"video",
  //     url, thumbUrl?, width?, height?, caption? }
  attachments   Json?
  // Quoted-reply snapshot: the post id + author + short excerpt being quoted, so
  // the quote renders even if the original is later edited/deleted.
  quotedId      String?
  quotedAuthor  String?
  quotedExcerpt String?     @db.Text
  parentId      String? // reply-to-reply (nesting)
  edited        Boolean     @default(false)
  deleted       Boolean     @default(false) // soft-delete: keep thread shape intact
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reactions ForumReaction[]

  @@index([threadId, createdAt])
  @@index([authorId])

  /// Structured entities for `content` — see lib/entities.
  ///
  /// NULL means legacy content written before this existed, and it stays
  /// readable: the renderer falls back to the @handle parser. There is no
  /// backfill and there does not need to be one.
  ///
  /// Json rather than a join table on purpose. Entities are read on EVERY
  /// render of the row they annotate and are never queried independently — a
  /// table would add a join to every feed page to answer a question nobody
  /// asks. The trade is that the database cannot enforce the shape, which is
  /// why sanitizeEntities treats this column as untrusted input on the way out.
  entities Json?

}

model ForumReaction {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("like") // like | fire | etc.
  createdAt DateTime  @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
}

// Follow / Subscribe a thread — the user gets it in their "Following" feed and
// (future) notifications. One row per user per thread.
model ForumSubscription {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

// Bookmark / Save a thread for later (distinct from following — no feed/notify
// semantics, just a personal saved list).
model ForumBookmark {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([threadId, userId])
  @@index([userId, createdAt])
}

// Community moderation — a member flags a thread or post for review.
model ForumReport {
  id         String   @id @default(cuid())
  targetType String // "thread" | "post"
  targetId   String
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String // spam | harassment | off_topic | other
  detail     String?  @db.Text
  status     String   @default("OPEN") // OPEN | REVIEWED | DISMISSED
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, reporterId]) // one report per user per target
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// Copyright / takedown notices.
///
/// Distinct from ForumReport: a copyright claim is a legal assertion by a rights
/// owner, needs a good-faith statement and a signature, and has a counter-notice
/// path. A community "this is spam" report has none of that.
///
/// The reporter does NOT have to be a signed-in user — a rights owner is usually a
/// stranger to the platform. Contact details are collected instead.
///
/// NOTE: this records notices and the action taken. It does NOT constitute
/// registration of a DMCA designated agent — that is an external filing with the US
/// Copyright Office, and it has not been done. See docs/EXTERNAL-COMPLIANCE-ACTIONS.md.
model CopyrightReport {
  id String @id @default(cuid())

  /// What is complained about, e.g. "clip:<id>", "forumPost:<id>", "fighter:<slug>".
  contentIdentifier String
  contentUrl        String?

  // ── The claimant ──────────────────────────────────────────────────────
  reporterName    String
  reporterEmail   String
  reporterOrg     String?
  /// The work they say was infringed.
  workDescription String   @db.Text
  /// "I am the rights owner or authorised to act for them."
  ownershipClaim  Boolean  @default(false)
  /// "I have a good-faith belief the use is not authorised."
  goodFaithClaim  Boolean  @default(false)
  /// Typed full name, standing as an electronic signature.
  signature       String
  signedAt        DateTime @default(now())

  // ── Our handling ──────────────────────────────────────────────────────
  status      String    @default("RECEIVED") // RECEIVED | REVIEWING | ACTIONED | REJECTED | COUNTER_NOTICED | RESTORED
  reviewerId  String?
  reviewer    User?     @relation("CopyrightReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String?   @db.Text
  actionTaken String? // removed | disabled | no_action
  actionedAt  DateTime?

  // ── Counter-notice ────────────────────────────────────────────────────
  counterNoticeAt   DateTime?
  counterNoticeBy   String? // user id of the uploader
  counterNoticeText String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contentIdentifier])
}

// ─── Combat Clips (user-uploaded native-video reels) ─────────────────────

// A user-uploaded fight clip. Stored as a native video file (R2/blob), so it
// autoplays reliably on mobile (unlike YouTube embeds). Rated by the community.

// ─── Community Predictions (native to Combat Register) ───────────────────
// Distinct from the live external market feed (Polymarket/Kalshi, which is
// read-only and lives entirely in src/features/predictions). These are our
// own community questions — "Who wins?", "Will this fight happen?", "Fight of
// the Night?" — that signed-in users vote on. Tallies are denormalised onto
// the market row for fast reads; one vote per user per market (upserted).
model CommunityMarket {
  id               String    @id @default(cuid())
  slug             String    @unique
  kind             String    @default("who_wins") // who_wins | will_happen | fotn | prop
  sport            String // Sport enum value as string (BOXING…)
  league           String? // UFC | Misfits | BKFC …
  title            String
  subtitle         String? // weight class / context line
  description      String?   @db.Text
  status           String    @default("open") // open | closed | resolved
  closesAt         DateTime?
  // options: [{ id, label, sub? }] — the choices users pick between.
  options          Json
  // tally: { [optionId]: count } — denormalised running totals.
  tally            Json?
  voteCount        Int       @default(0)
  featured         Boolean   @default(false)
  hot              Boolean   @default(false)
  seedKey          String?   @unique // maps a seeded fixture → its row
  // When set, this row is the community vote attached to an external market
  // (e.g. "polymarket:0x…" / "kalshi:KX…") rather than a standalone question.
  // Such rows are excluded from the standalone "Fight Pulse" list.
  providerMarketId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  votes CommunityVote[]

  @@index([sport, status])
  @@index([status, voteCount])
}

model CommunityVote {
  id        String          @id @default(cuid())
  marketId  String
  market    CommunityMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice    String // an option id from the market
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([marketId, userId]) // one vote per user per market
  @@index([userId])
  @@index([marketId, choice])
}

// ─── Users & accounts (Auth.js model-compatible) ────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  /// When staff approved this user's professional identity. A timestamp rather
  /// than a boolean, matching `emailVerified` above: "verified" and "verified
  /// on 4 August" are different questions and only one of them survives a
  /// boolean. The verified badge derives from this — there is no separate flag
  /// to fall out of sync with it.
  professionalVerifiedAt DateTime?
  /// Presence heartbeat — the last moment this user's client said it was there.
  ///
  /// A TIMESTAMP, never an `isOnline` boolean, and the reason is the same one
  /// `ConversationMember.typingAt` gives: a boolean has to be set back to false
  /// by a disconnect the server never observes (a closed laptop, a killed tab,
  /// a train tunnel), so every product that stores online as a flag eventually
  /// shows somebody online for three days. Presence is `now - lastSeenAt`, so
  /// it decays on its own with nothing to sweep.
  ///
  /// Written by a throttled heartbeat (lib/presence/repo) — at most once per
  /// HEARTBEAT_MS per user, so it is a cheap single-column update rather than
  /// a write on every request. Derivation lives in lib/presence/derive.
  lastSeenAt    DateTime?
  image         String?
  username      String?   @unique
  bannerUrl     String? // profile cover image (user-uploaded)
  passwordHash  String? // bcrypt; null for OAuth-only accounts
  // Session epoch. Every issued JWT carries this value; bumping it revokes all
  // outstanding sessions at once (password change / reset / sign-out-everywhere).
  tokenVersion  Int       @default(0)

  // Age declaration. Deliberately an ACKNOWLEDGEMENT, not a date of birth: we need
  // to know you meet the minimum age, and a full birth date is more personal data
  // than that question requires (data minimisation). It is never displayed publicly.
  //
  // This is NOT proof of age and is not presented as such — see /responsible-gambling.
  ageConfirmed     Boolean   @default(false) // "I am at least MINIMUM_AGE"
  ageConfirmedAt   DateTime?
  agePolicyVersion String? // which wording they agreed to
  // Consent to the Terms and Privacy Notice, recorded the same way. WHEN they
  // agreed and WHICH VERSION they agreed to are the only things that make a
  // consent demonstrable later (UK/EU GDPR Art. 7(1)) — a boolean alone cannot
  // answer "what did they actually accept?" once the wording changes.
  // Null for accounts created before the tick existed; never backfilled, because
  // inventing a consent nobody gave is the one thing worse than not having one.
  termsAcceptedAt  DateTime?
  termsVersion     String?
  // Set when a user tells us they are under age: the account is restricted pending
  // deletion rather than silently kept.
  underageFlagged  Boolean   @default(false)
  registryRole     String    @default("fan") // signup intent: fan|fighter|coach|gym|promoter|manager|official|media
  role             UserRole  @default(USER)
  reputation       Int       @default(0)
  // Denormalised prediction record — written only by the resolution engine
  // (src/lib/intelligence/resolve.ts) so accuracy/streak/leaderboard are O(1) reads.
  picksResolved    Int       @default(0)
  picksCorrect     Int       @default(0)
  pickStreak       Int       @default(0) // current consecutive correct picks
  bestPickStreak   Int       @default(0)
  // Denormalised battle record (O(1) profile reads) — written by resolveFightBattles.
  battleWins       Int       @default(0)
  battleLosses     Int       @default(0)
  battleDraws      Int       @default(0)
  battleStreak     Int       @default(0) // current consecutive battle wins
  bestBattleStreak Int       @default(0)
  // ── Daily habit loop ──────────────────────────────────────────────────
  // Every other counter on this model moves only when a FIGHT happens, which
  // is why the product has no reason to be opened on a Tuesday. These three do
  // move daily. `lastActiveOn` is a UTC midnight (a DAY, not an instant) — the
  // comparison that decides "is this a new day for you" has to be day-grained
  // or a streak breaks at 23:59 and survives at 00:01 for no reason a user
  // could explain.
  lastActiveOn     DateTime? // UTC midnight of the last day this user showed up
  dayStreak        Int       @default(0) // consecutive days, current
  bestDayStreak    Int       @default(0)
  activeDays       Int       @default(0) // lifetime distinct days — never resets
  bio              String?
  /// Disciplines chosen in the first-run flow. A scalar list rather than a join
  /// table: it is a small ordered set read on nearly every personalised query,
  /// so a join would cost a round trip to save nothing.
  sportPrefs       String[]
  /// Stamped when the first-run flow is finished OR skipped. Null means the user
  /// has never seen it — the only condition that routes anyone into onboarding.
  onboardedAt      DateTime?
  localePref       String    @default("en")
  themePref        String    @default("dark")
  createdAt        DateTime  @default(now())

  // ── Community map presence ────────────────────────────────────────────
  // Opt-IN, and opt-in twice: a user is only ever plotted when they have both
  // chosen a visibility other than HIDDEN and told us a city. See the
  // MapVisibility enum for why there is no GPS column here — the point we
  // plot is a city centre they picked, never a device position.
  mapVisibility      MapVisibility @default(HIDDEN)
  mapCity            String?
  mapCountryCode     String?
  /// Resolved from mapCity/mapCountryCode through the gazetteer at save time,
  /// so the people layer is one indexed read instead of N lookups per render.
  mapLat             Float?
  mapLon             Float?
  /// Discoverability flags — these are the map's "role" filters.
  openToSpar         Boolean       @default(false)
  lookingForTraining Boolean       @default(false)

  // ── Notification preferences ──────────────────────────────────────────
  // Categories rather than one switch per notification TYPE: a user thinks
  // "stop telling me about fights", not "disable FIGHT_ANNOUNCED and
  // EVENT_LIVE". Types map onto these in src/lib/push/policy.ts, so adding a
  // NotificationType never requires a migration.
  //
  // Defaults are ON for everything a user opted into by following something,
  // because the notification is the thing they asked for. Push still requires
  // an explicit browser permission on top — see PushSubscription.
  notifyFights      Boolean @default(true) // reminders, going live, card changes
  notifyPredictions Boolean @default(true) // lock deadlines, results, rank moves
  notifySocial      Boolean @default(true) // replies, mentions, follows, battles
  notifyGym         Boolean @default(true) // check-ins, membership, verification
  /// Direct messages get their OWN switch rather than riding notifySocial.
  /// A DM is addressed to one person by another person; a reply-to-your-thread
  /// is not. Someone who mutes "replies and follows" because a busy thread is
  /// pinging them has said nothing about whether they want to know a friend
  /// messaged them — and folding the two together is exactly the
  /// two-switches-for-one-thing bug that lib/push/policy already documents
  /// against GYM_REVIEW.
  notifyMessages    Boolean @default(true) // direct messages

  // ── Presence privacy ──────────────────────────────────────────────────────
  //
  // Four switches, not one, because they answer genuinely different questions
  // and people want different answers: "don't show when I'm around" is not the
  // same request as "don't tell people I've read their message". Collapsing
  // them into a single "private mode" would force somebody who only wanted to
  // hide read receipts to also disappear from the app.
  //
  // Default ON, and that is a deliberate call rather than an oversight. A
  // presence system where nobody is visible by default is a presence system
  // that never works — the first person to enable it sees an empty room and
  // turns it back off. The mitigation is that every switch is one tap away in
  // Settings, each states exactly what it does, and the two that touch the
  // OTHER person's information (typing, read receipts) are mutual: turning
  // yours off also stops you seeing theirs. You cannot take without giving.
  //
  // showOnlineStatus is the MASTER. With it off, nothing about when this user
  // is around is derivable: no dot, no away state, and no last-seen — because
  // "last seen 2 minutes ago" is just "online" written slowly.
  showOnlineStatus     Boolean @default(true)
  /// Secondary to showOnlineStatus: keep the live dot, hide the history.
  showLastSeen         Boolean @default(true)
  /// MUTUAL — see lib/presence/policy. Off means you neither send nor receive.
  allowTypingIndicator Boolean @default(true)
  /// MUTUAL — see lib/presence/policy. Off means both sides stop at Delivered.
  allowReadReceipts    Boolean @default(true)
  /// Local hours [start, end) during which push is withheld. Null = always on.
  /// Stored as plain hours + an IANA zone rather than UTC instants: "no pings
  /// before 8am" has to survive the user travelling.
  quietHoursStart   Int?
  quietHoursEnd     Int?
  timezone          String?

  // ── Public identity ───────────────────────────────────────────────────
  // Flat columns rather than a UserSocial join table (the shape Fighter uses):
  // a fixed set of five known platforms is read on every profile render, so a
  // join would cost a round trip to model nothing extra. Fighter's table earns
  // its keep because a fighter's links are editorially curated and open-ended.
  website         String?
  instagram       String?
  twitter         String?
  youtube         String?
  tiktok          String?
  facebook        String?
  /// Fighters only, and self-declared — never presented as a verified record.
  weightClassPref String?
  yearsTraining   Int?

  accounts          Account[]
  sessions          Session[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  identityVerifications         IdentityVerification[] @relation("IdentityVerifications")
  identityVerificationsReviewed IdentityVerification[] @relation("IdentityVerificationsReviewed")
  predictions       Prediction[]
  articles          Article[]
  threads           ForumThread[]
  posts             ForumPost[]
  reactions         ForumReaction[]
  subscriptions     ForumSubscription[]
  bookmarks         ForumBookmark[]
  reports           ForumReport[]
  communities       CommunityMember[]
  communityVotes    CommunityVote[]
  favorites         FavoriteFighter[]
  promotionFollows  FavoritePromotion[]
  eventFollows      FavoriteEvent[]
  fightPicks        FightPick[]
  reputationEvents  ReputationEvent[]
  /// Result candidates this operator has approved, rejected or edited.
  resultsReviewed   ResultCandidate[]    @relation("ResultReviewer")
  notifications     Notification[]
  activities        Activity[]
  /// Media this user UPLOADED. SetNull on delete: an asset outlives the
  /// uploader's account (it may still be referenced by a published post), and
  /// severing the link is the anonymisation, not deleting the bytes.
  uploadedMedia     MediaAsset[] @relation("MediaUploader")
  cardAwards        CardAward[]
  follows           Follow[]
  battlesChallenged Battle[]             @relation("BattleChallenger")
  battlesOpposed    Battle[]             @relation("BattleOpponent")
  rivalriesA        Rivalry[]            @relation("RivalryA")
  rivalriesB        Rivalry[]            @relation("RivalryB")
  fighterProfile    Fighter?             @relation("FighterOwner")
  claimsMade        FighterClaim[]       @relation("ClaimsMade")
  claimsReviewed    FighterClaim[]       @relation("ClaimsReviewed")
  copyrightReviewed CopyrightReport[]    @relation("CopyrightReviewed")
  gymMemberships    GymMember[]
  gymsOwned         Gym[]                @relation("GymOwner")
  gymClaimsMade     GymClaim[]           @relation("GymClaimsMade")
  gymClaimsReviewed GymClaim[]           @relation("GymClaimsReviewed")
  promoterOrgsOwned PromoterOrg[]        @relation("PromoterOrgOwner")
  promoterClaims    PromoterClaim[]
  gymReviews        GymReview[]          @relation("GymReviewAuthor")
  gymReviewVotes    GymReviewVote[]
  feedbackAuthored  FeedbackItem[]       @relation("FeedbackAuthored")
  feedbackResolved  FeedbackItem[]       @relation("FeedbackResolved")
  feedbackVotes     FeedbackVote[]
  checkIns          CheckIn[]
  following         UserFollow[]         @relation("Follower")
  followers         UserFollow[]         @relation("Following")
  pushSubscriptions PushSubscription[]
  conversations     ConversationMember[]
  sentMessages      DirectMessage[]      @relation("MessageSender")
  gymPosts          GymPost[]            @relation("GymPostAuthor")
  gymPostsRemoved   GymPost[]            @relation("GymPostRemover")
  gymPostComments   GymPostComment[]     @relation("GymPostCommentAuthor")
  gymPostReactions  GymPostReaction[]
  gymPostCommentReactions GymPostCommentReaction[]

  @@index([reputation])
  // The people layer's hot path: "visible users who have a resolved point".
  @@index([mapVisibility, mapLat])
  // Retention cohorts (D1/D7/D30) in metrics.ts scan users by createdAt window.
  @@index([createdAt])
  // The Return Engine's streak-warning pass ranges on lastActiveOn each hour
  // ("streaks alive yesterday, not extended today"); without this it scans User.
  @@index([lastActiveOn])
}

/// Forgotten-password reset tokens.
///
/// Only a SHA-256 hash of the token is stored — a database leak must not yield
/// usable reset links. The raw token exists solely in the emailed URL. Tokens
/// are single-use (`usedAt`), short-lived (`expiresAt`), and superseded: issuing
/// a new token marks every prior unused token for that user as consumed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256(raw token), hex
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String? // for abuse investigation; not shown to users

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model FavoriteFighter {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterId String
  fighter   Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, fighterId])
}

/// A user following a promotion. Keyed by the promotion REGISTRY slug
/// (resolvePromotion().slug, e.g. "ufc") rather than a Promotion FK, because
/// events carry promotion as a free-text name and the Promotion table is sparse
/// — the registry slug is the stable identifier used across the UI.
model FavoritePromotion {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion String
  createdAt DateTime @default(now())

  @@id([userId, promotion])
  @@index([promotion])
}

/// A followed EVENT — the highest-intent follow there is: it means "remind me
/// about this card". Distinct from following a promotion (a standing interest);
/// this is a commitment to one date, and it's what the reminder scheduler and
/// the Following feed key off.
model FavoriteEvent {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
  @@index([userId, createdAt])
}

/// A POLYMORPHIC follow: one row per (user, target).
///
/// Following already existed as three separate tables — FavoriteFighter,
/// FavoritePromotion, FavoriteEvent — one per entity, each with its own toggle,
/// its own lookup and its own count query. Adding gyms and people that way would
/// have meant two more tables and two more of everything, and every future entity
/// another pair.
///
/// So new targets live here, keyed by (targetType, targetId), and lib/follows.ts
/// presents ONE API over both. The legacy tables are deliberately NOT migrated:
/// they carry real user data and real FKs, and a rewrite of working follows is
/// risk with no user-visible payoff. They are routed to, not replaced.
model Follow {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "gym" | "person" | … — see FollowTargetType in lib/follows.ts.
  targetType String
  /// The target's stable id. A cuid for a row-backed entity, a registry slug otherwise.
  targetId   String
  createdAt  DateTime @default(now())

  /// One follow per user per target — the database enforces it, so a double-tap
  /// or a replayed request cannot create a second row or a second notification.
  @@unique([userId, targetType, targetId])
  /// Follower fan-out reads (targetType, targetId) and needs it indexed: notifying
  /// a gym's followers must not scan the table.
  @@index([targetType, targetId])
  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

/// Email-address verification, by short numeric code.
///
/// Replaces the Auth.js-shaped `VerificationToken` that sat here unused — it had
/// no userId, no attempt counter and no send timestamp, so it could not express
/// either of the two controls a 6-digit code actually needs.
///
/// Why a code and not a link: the entropy is only ~20 bits, so the security does
/// NOT come from the secret. It comes from three things this model stores —
/// the code is bound to a `userId` (you must already hold the session to try
/// one, which removes the global guessing attack entirely), `attempts` kills the
/// token after a handful of wrong tries, and `expiresAt` keeps the window short.
/// `codeHash` is sha256(code + userId), so two users sharing a code do not share
/// a hash, and a leaked table still yields nothing replayable against a
/// different account.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // sha256(code + userId), hex. NOT unique — see note above.
  /// The address the code was sent to. A code stops being valid if the user
  /// changes their email before entering it.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  /// Resend cooldown is measured from here, server-side. The UI countdown is a
  /// courtesy; this is the control.
  sentAt    DateTime  @default(now())
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  requestIp String? // for abuse investigation; not shown to users

  @@index([userId, usedAt])
  @@index([expiresAt])
}

// ─── Scraper bookkeeping ────────────────────────────────────────────────

model ScrapeJob {
  id         String       @id @default(cuid())
  target     String // "rankings:heavyweight", "fighter:12345"
  status     ScrapeStatus @default(PENDING)
  attempts   Int          @default(0)
  error      String?      @db.Text
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@index([target])
}

// ════════════════════════════════════════════════════════════════════════
//  Multi-source data-intelligence layer
//  Registry of providers + their health/sync telemetry, and the canonical
//  identity maps (external ids / aliases) used by the dedupe engine.
//  See src/services/{providers,aggregator,dedupe,normalization}.
// ════════════════════════════════════════════════════════════════════════

enum DataSourceKind {
  API
  SCRAPER
  MANUAL
}

model DataSource {
  id             String         @id @default(cuid())
  key            String         @unique // "sportradar", "tapology", "api-sports", "scraper"
  label          String
  kind           DataSourceKind @default(API)
  baseConfidence Float          @default(0.5) // 0..1 default trust weight
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())

  health ProviderHealth[]
  syncs  ProviderSync[]
}

model ProviderHealth {
  id          String     @id @default(cuid())
  sourceKey   String
  source      DataSource @relation(fields: [sourceKey], references: [key], onDelete: Cascade)
  ok          Boolean    @default(true)
  latencyMs   Int?
  rateLimited Boolean    @default(false)
  error       String?    @db.Text
  checkedAt   DateTime   @default(now())

  @@index([sourceKey, checkedAt])
}

model ProviderSync {
  id            String     @id @default(cuid())
  sourceKey     String
  source        DataSource @relation(fields: [sourceKey], references: [key], onDelete: Cascade)
  sport         String? // Sport enum value, or null = all
  entity        String // events | fighters | rankings | results | news
  status        String     @default("RUNNING") // RUNNING | SUCCESS | FAILED | FALLBACK
  imported      Int        @default(0)
  updated       Int        @default(0)
  rejected      Int        @default(0)
  failures      Int        @default(0)
  rateLimitHits Int        @default(0)
  durationMs    Int?
  fellBackTo    String? // source key the run fell back to
  error         String?    @db.Text
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  @@index([sourceKey, startedAt])
  @@index([entity, status])
}

model FighterExternalId {
  id         String   @id @default(cuid())
  fighterId  String
  fighter    Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  source     String // "tapology" | "sportradar" | ...
  externalId String
  confidence Float    @default(1)
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([fighterId])
}

model EventExternalId {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source     String
  externalId String
  confidence Float    @default(1)
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([eventId])
}

model FighterAlias {
  id         String   @id @default(cuid())
  fighterId  String
  fighter    Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  alias      String // raw alias as seen upstream
  normalized String // normalized form for matching
  source     String?
  createdAt  DateTime @default(now())

  /// The same alias must not be recorded twice for one fighter — every ingest
  /// pass would otherwise append another row for a name it has already seen, and
  /// the alias table is read on the hot path of identity resolution.
  @@unique([fighterId, normalized])
  @@index([normalized])
  @@index([fighterId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  THE EVIDENCE LAYER
//
//  The architectural finding in docs/DATA_AUDIT.md: rankings and champions were
//  resolved DESTRUCTIVELY at write time. `Ranking` is unique per (division,
//  p4p, fighter, organisation), so a second provider's opinion had nowhere to
//  live — the higher-trust source overwrote the lower one and what it replaced
//  was gone, unrecorded. Nothing could explain why a fighter was ranked where
//  they were, and no conflict could even be DETECTED, because the losing value
//  never landed.
//
//  So providers no longer write conclusions. They write OBSERVATIONS:
//
//      provider ──> Observation (append-only, immutable, what a source said)
//                        │
//                   reconciler (pure, deterministic, tier-ordered)
//                        │
//                        ▼
//                   Projection (Ranking / TitleReign — what we BELIEVE)
//
//  The projection carries the observation ids behind it, so every published
//  number can be traced to the exact source rows that produced it. Tier 2
//  (Wikipedia/Wikidata) can never overwrite Tier 1 (official) — but it is still
//  RECORDED, which is what makes disagreement visible instead of invisible.
// ═══════════════════════════════════════════════════════════════════════════

/// Source trust tier. The ORDER is the reconciliation rule — lower wins.
enum EvidenceTier {
  /// Official promotion APIs, official ranking releases, official title
  /// announcements. The organisation speaking about its own belt.
  OFFICIAL
  /// Structured open data: Wikidata, the Wikipedia API. Good, independent, and
  /// never authoritative over an organisation's own publication.
  ENCYCLOPAEDIC
  /// Licensed third-party databases (Sherdog / Tapology / BoxRec, each only if
  /// its terms permit — see docs/RANKINGS.md and the licence flags in code).
  AGGREGATOR
  /// Our own history and archived snapshots. The floor: enough to keep serving
  /// something explainable when every live provider is dark.
  INTERNAL
}

/// What a provider SAID about one fighter's rank, at one moment.
///
/// Append-only and immutable. Never updated, never deleted by normal operation.
/// A provider re-publishing the same list produces no new row (the payload hash
/// is unchanged, so the ingest skips the write entirely) — but a CHANGED list
/// produces a new observation and leaves the previous one intact, which is what
/// makes "when did this change, and according to whom?" answerable.
model RankingObservation {
  id String @id @default(cuid())

  /// Connector id, e.g. "ufc-mma", "wikidata-boxing". Matches the provider
  /// registry in lib/registry/providers.
  provider String
  tier     EvidenceTier

  /// The canonical fighter this row is ABOUT. Resolved through the one identity
  /// resolver before the observation is written — an observation whose subject
  /// could not be resolved is not written at all; it becomes an identity
  /// candidate for review instead, so ranks are never attached to a guess.
  fighterId String
  fighter   Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  /// Division as the SOURCE names it, plus our resolved WeightClass. Both, so a
  /// re-parse can be audited against what the source actually published.
  divisionLabel   String
  weightClassId   String?
  weightClass     WeightClass? @relation(fields: [weightClassId], references: [id], onDelete: SetNull)
  isPoundForPound Boolean      @default(false)
  /// "UFC", "WBA", … Empty string = a cross-promotional list belonging to the
  /// sport rather than to any one body. Empty rather than NULL for the same
  /// reason Ranking.organisation is: NULLs are DISTINCT in a unique index.
  organisation    String       @default("")
  /// "male" | "female". Every connector parses this into RankingEntry.gender and
  /// it was then DROPPED at persistence — the only thing carrying it downstream
  /// was the division NAME ("Women's Heavyweight"), a convention both current
  /// connectors happen to follow rather than anything the schema enforces.
  /// Recorded now so a division can be AUDITED for gender mixing instead of
  /// trusted to a prefix.
  gender          String?

  rank Int

  /// When the SOURCE says this is effective — its publication date, not our
  /// fetch time. Parsed into RankingEntry and then DROPPED at persistence in the
  /// old pipeline; it is the single most useful column for reconciling two
  /// providers who disagree, because the newer publication usually wins.
  effectiveDate DateTime
  /// When WE retrieved it. Distinct from effectiveDate on purpose.
  retrievedAt   DateTime @default(now())
  /// Provenance. Never returned to a client as a link to follow blindly.
  sourceUrl     String?
  /// 0..1, from the provider's tier. Stored so a historical observation keeps
  /// the confidence it had when written, even if the tier is later re-rated.
  confidence    Float
  /// SHA-256 of the provider's normalized payload for this list. Identical hash
  /// on the next run → nothing is written at all.
  payloadHash   String?

  /// One observation per provider per fighter per list per effective date. A
  /// re-run of the same publication is a no-op rather than a duplicate row.
  @@unique([provider, fighterId, weightClassId, isPoundForPound, organisation, effectiveDate])
  /// The reconciler's read: everything currently known about one list.
  @@index([weightClassId, isPoundForPound, organisation, effectiveDate])
  @@index([fighterId, retrievedAt])
  @@index([provider, retrievedAt])
}

/// Title status. A belt is not a boolean.
enum TitleStatus {
  /// Undisputed holder of this body's title in this division.
  CHAMPION
  /// Interim titleholder — a real, separate reign, not a lesser champion.
  INTERIM
  /// Nobody holds it. A reign with no fighter, which the old boolean could not
  /// express at all.
  VACANT
  /// Taken from the holder by the body (missed weight, failed test, inactivity).
  /// Distinct from losing it in the ring, and the distinction is the record.
  STRIPPED
  /// The holder retired as champion.
  RETIRED
  /// Recognised lineal succession rather than a body's belt. Modelled now,
  /// populated later — see docs/RANKINGS.md.
  LINEAL
}

/// What a provider SAID about who holds a title. Append-only, same contract as
/// RankingObservation.
model ChampionObservation {
  id       String       @id @default(cuid())
  provider String
  tier     EvidenceTier

  /// Null when the observation is that the title is VACANT — which is a fact
  /// about the belt, not about a person, and had no representation before.
  fighterId String?
  fighter   Fighter? @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  weightClassId String
  weightClass   WeightClass @relation(fields: [weightClassId], references: [id], onDelete: Cascade)
  /// The sanctioning body / promotion as a STRING, not the SanctioningBody enum.
  /// The enum cannot represent a body we have not shipped a migration for, and
  /// refusing to record a real observation because our enum is behind is exactly
  /// how evidence gets silently dropped (see ingest.ts::sanctioningBodyFor,
  /// which returned null and skipped the champion).
  organisation  String
  status        TitleStatus @default(CHAMPION)
  /// "male" | "female". A belt is gendered, and the old Champion table had no
  /// way to say so — which is why "every boxing champion is a woman" could not
  /// be told apart from a mapping bug without reading the connector registry.
  gender        String?

  effectiveDate DateTime
  retrievedAt   DateTime @default(now())
  sourceUrl     String?
  confidence    Float
  payloadHash   String?

  @@unique([provider, weightClassId, organisation, status, effectiveDate])
  @@index([weightClassId, organisation, effectiveDate])
  @@index([fighterId, effectiveDate])
}

/// A TITLE REIGN. Permanent, and the replacement for everything the old schema
/// could not hold.
///
/// `Champion` is `@@unique([weightClassId, body, current])` on a BOOLEAN, which
/// permits at most TWO rows per (division, body) for all time — one current, one
/// not. The workaround in the old ingest updated the champion in place and reset
/// `since: null, defenses: 0`, so every title change destroyed the previous
/// reign's start date and defence count. There was no history, and no way to add
/// one without removing that constraint.
///
/// This model has no such ceiling: a division accumulates reigns forever. The
/// invariant "at most one OPEN reign per (division, organisation, status)" is
/// enforced by a partial unique index in SQL rather than by a boolean column —
/// see prisma/sql/title-reign.sql, applied by the reconciler's migration step.
model TitleReign {
  id String @id @default(cuid())

  /// Null for a VACANT reign — the period during which nobody held the belt.
  fighterId String?
  fighter   Fighter? @relation(fields: [fighterId], references: [id], onDelete: SetNull)

  weightClassId String
  weightClass   WeightClass @relation(fields: [weightClassId], references: [id], onDelete: Cascade)
  organisation  String
  status        TitleStatus @default(CHAMPION)
  gender        String?

  /// When the reign began and ended. `endedAt` null = still open.
  startedAt DateTime
  endedAt   DateTime?
  /// Successful defences during THIS reign. Never reset by a later reign,
  /// because a later reign is a different row.
  defenses  Int       @default(0)

  /// The bouts that started and ended it, when we know them. Nullable because a
  /// title can change hands outside a bout (stripped, vacated).
  wonAtFightId  String?
  lostAtFightId String?

  /// How this reign was decided: the reconciler's verdict plus the observation
  /// ids behind it. A reign that cannot explain itself is exactly what this
  /// sprint exists to remove.
  decidedBy       String?
  evidence        Json?
  /// True when providers disagreed and the tier order broke the tie. Surfaces
  /// in the admin conflict view.
  contested       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@index([weightClassId, organisation, startedAt])
  @@index([fighterId, startedAt])
  @@index([endedAt])
}

/// A possible identity match that is NOT confident enough to act on.
///
/// The rule this table exists to hold: NEVER MERGE AUTOMATICALLY BELOW THE
/// THRESHOLD. When the resolver cannot be sure, it does not guess and it does
/// not silently create a parallel fighter — it records the question here and a
/// human answers it.
model FighterIdentityCandidate {
  id String @id @default(cuid())

  /// The row we are unsure about (a provisional fighter, or the incoming one).
  fighterId String
  fighter   Fighter @relation("IdentityCandidateSubject", fields: [fighterId], references: [id], onDelete: Cascade)
  /// The row it MIGHT be the same person as.
  candidateId String
  candidate   Fighter @relation("IdentityCandidateMatch", fields: [candidateId], references: [id], onDelete: Cascade)

  /// Which rung of the ladder fired, and how strongly.
  via        String
  confidence Float
  /// The comparable facts, so a reviewer decides from data rather than a score:
  /// { "name": [...], "dob": [...], "nationality": [...], "externalIds": [...] }
  evidence   Json?
  /// What triggered it: "ingest" | "signup" | "audit".
  origin     String @default("ingest")

  /// PENDING | MERGED | REJECTED
  status     String    @default("PENDING")
  reviewerId String?
  reviewedAt DateTime?
  note       String?

  createdAt DateTime @default(now())

  /// One open question per pair, whichever way round it is raised.
  @@unique([fighterId, candidateId])
  @@index([status, confidence])
  @@index([candidateId])
}

/// Per-provider incremental-sync state.
///
/// The media pipeline already proved this shape works (ETag + If-Modified-Since
/// + content hash, with `unchanged-304` and `unchanged-hash` as first-class
/// outcomes). Rankings had none of it: every run re-fetched, re-parsed and
/// re-wrote identical rows, and appended a RankSnapshot per fighter per run
/// whether or not anything had changed.
///
/// `lastChangedAt` is the column that makes freshness honest. "Checked an hour
/// ago" and "changed an hour ago" are different facts, and a dashboard that
/// conflates them reports a dead provider as healthy.
model ProviderCheckpoint {
  id       String @id @default(cuid())
  /// Connector id + an optional scope ("ufc-mma", scope "rankings").
  provider String
  scope    String @default("")

  etag         String?
  lastModified String?
  /// SHA-256 of the last normalized payload. The cheap "did anything change?".
  payloadHash  String?

  /// ── WHERE THE LAST RUN GOT TO ────────────────────────────────────────────
  /// An opaque, provider-defined resume position. For an ARCHIVE crawl it is the
  /// last index page scanned.
  ///
  /// Without it every backfill restarts at page 1 and re-reads what it already
  /// has, which is why "walk deeper" meant passing a bigger `--pages` by hand
  /// each time and re-fetching everything shallower on every run. With it a
  /// nightly cron simply continues, and the job becomes self-maintaining instead
  /// of a recurring manual chore.
  ///
  /// Null means "start from the beginning" — which is also what a completed
  /// archive resets to, because once the deep history is in, the only thing
  /// worth checking is the newest page.
  cursor       String?
  /// Whether the deep crawl has reached the end of the archive. Once true the
  /// provider runs in INCREMENTAL mode: page 1 only, looking for new
  /// publications rather than old ones.
  exhausted    Boolean @default(false)
  /// Last run's counters — rows inserted / updated / skipped, duration, whatever
  /// the provider reports. Json because every provider counts different things,
  /// and a column per metric would be a migration per connector.
  stats        Json?

  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  /// Consecutive failures. Reset on any success — a provider that fails once is
  /// noise; one that has failed eleven times in a row is an outage.
  failureStreak Int       @default(0)
  lastError     String?

  updatedAt DateTime @updatedAt

  @@unique([provider, scope])
  @@index([lastCheckedAt])
}

/// Where a BOUT came from. A separate table, not columns on Fight, deliberately:
/// every `fight.findMany` without an explicit select would pull new scalars and 500
/// against a database that has not run `db:push` yet — and scripts are routinely
/// pointed at production from a developer's machine, ahead of the deploy. A missing
/// TABLE only breaks the queries that touch it, and those are all best-effort.
///
/// This exists because a historical repair could not be audited: `Fight` recorded
/// createdAt and nothing else, so "which bouts did the Wikipedia repair write, from
/// which page?" was unanswerable and cleanup had to be inferred from slug shapes.
/// Every future import answers it directly.
model FightImport {
  id         String   @id @default(cuid())
  fightId    String
  fight      Fight    @relation(fields: [fightId], references: [id], onDelete: Cascade)
  /// Provider key: "wikipedia" | "bkfc" | "one" | "adcc" | "odds" | …
  source     String
  /// The source's own reference — for Wikipedia, the page title the card came from.
  sourceRef  String?
  /// True when this row CREATED the bout; false when it only updated one.
  created    Boolean  @default(false)
  importedAt DateTime @default(now())

  @@unique([fightId, source])
  @@index([source, importedAt])
  @@index([fightId])
}

// ─── Promotion Registry ─────────────────────────────────────────────────
// Canonical list of combat-sports promotions, seeded from the Global Combat
// Sports Promotions Registry workbook and kept live by ingestion. Promotion
// is the parent entity that news Articles and Events resolve to; per-promotion
// ingestion source URLs live on PromotionSource (the DB-backed source table
// the pipeline previously lacked — sources used to be hardcoded arrays).

enum PromotionStatus {
  VERIFIED_ACTIVE
  ACTIVE_RECURRING
  ACTIVE_SPORADIC
  ANNOUNCED
  ACTIVITY_UNCLEAR
  DORMANT
  DEFUNCT
}

enum PromotionSourceType {
  OFFICIAL_SITE
  NEWS
  PRESS
  RSS
  SCHEDULE // upcoming events / calendar page
  RESULTS
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  TWITTER // X
  TIKTOK
  AGGREGATOR // tapology / sherdog / espn secondary source
}

model Promotion {
  id           String          @id @default(cuid())
  slug         String          @unique // slugify(name)
  name         String
  acronym      String?
  sport        Sport // mapped from registry "Sport"
  ruleset      String? // raw "Ruleset / Discipline" text
  country      String?
  countryCode  String?
  region       String?
  scope        String? // "Geographic Scope"
  entityType   String? // "Commercial promotion", "Federation-operated"...
  status       PromotionStatus @default(ACTIVE_RECURRING)
  officialUrl  String? // "Primary Source URL"
  secondaryUrl String? // "Secondary Source URL"
  confidence   String? // "High" | "Medium" | "Low"
  evidence     String?         @db.Text // "Evidence / Recency"
  notes        String?         @db.Text
  active       Boolean         @default(true) // false = dormant/defunct
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sources  PromotionSource[]
  articles Article[]
  events   Event[]

  @@index([sport, status])
  @@index([country])
  @@index([active])
}

model PromotionSource {
  id            String              @id @default(cuid())
  promotionId   String
  promotion     Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type          PromotionSourceType
  url           String
  label         String?
  method        String? // "rss-syndication" | "scrape" | "link-only"
  official      Boolean             @default(true)
  enabled       Boolean             @default(true) // gated by ingestion policy; link-only sources are not fetched
  lastFetchedAt DateTime?
  lastStatus    String?
  discoveredAt  DateTime            @default(now())

  @@unique([promotionId, url])
  @@index([type, enabled])
  @@index([promotionId])
}

// News outlets / media platforms — the press side of the registry, seeded from
// the Global Combat-Sports News Platforms directory. These are RSS/syndication
// sources for the news pipeline (distinct from Promotion, which is the org).
model NewsOutlet {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  website   String
  sports    Sport[] // multi-discipline outlets carry several
  region    String?
  language  String?
  notes     String?  @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

// ─── Combat Feed ────────────────────────────────────────────────────────
// Video catalog + per-user feed state. `key` is the feed identity: an
// authenticated user id when signed in (so preferences follow the account
// across devices), otherwise the anonymous browser client id.

model FeedVideo {
  id          String    @id // YouTube video id
  title       String
  channel     String
  channelId   String?
  description String?
  publishedAt DateTime?
  viewCount   Int?
  topic       String?
  tags        String[]
  /// Promotion slug from lib/promotions ("ufc", "bkfc"…), or null for
  /// independent media. Stamped from the trusted channel entry, never guessed
  /// from the payload — it is what FavoritePromotion rows are keyed by, so a
  /// wrong value here means notifying the wrong followers.
  promotion   String?
  /// Discipline slug matching SPORT_PILLS ("mma", "boxing", "muay-thai"…), so
  /// a video filters by the same vocabulary as ?sport= everywhere else.
  discipline  String?
  addedAt     DateTime  @default(now())

  discussions ForumThread[]

  @@index([addedAt])
  @@index([topic])
  @@index([promotion, publishedAt])
  @@index([discipline, publishedAt])
}

/// Cross-instance job leases — see src/lib/job-lease.ts. Replaces session-scoped
/// pg_advisory_lock, which leaked across Prisma's connection pool and wedged
/// feed ingestion after a single run. Rows are disposable: an expired lease is
/// simply claimable again.
model JobLease {
  name      String   @id
  expiresAt DateTime
}

model FeedView {
  key      String
  videoId  String
  servedAt DateTime @default(now())

  @@id([key, videoId])
  @@index([key])
}

model FeedHiddenChannel {
  key       String
  channelId String

  @@id([key, channelId])
}

model FeedNotInterested {
  key     String
  videoId String

  @@id([key, videoId])
}

model FeedInterest {
  key    String
  tag    String
  weight Float  @default(0)

  @@id([key, tag])
}

// ─── Combat Feed · Personal Library ─────────────────────────────────────
// Saved videos, Watch Later, Favorites and user-made Collections. `key` is the
// feed identity (authed user id when signed in, else anonymous client id), same
// as the other feed tables. Item rows snapshot the video's display fields so a
// saved video still renders even after it ages out of the rolling catalog.

model FeedCollection {
  id        String               @id @default(cuid())
  key       String
  name      String
  system    String? // "watch_later" | "favorites" | null (user-created)
  createdAt DateTime             @default(now())
  items     FeedCollectionItem[]

  @@unique([key, system]) // at most one of each system collection per key
  @@index([key])
}

model FeedCollectionItem {
  collectionId String
  videoId      String
  title        String
  channel      String
  channelId    String?
  topic        String?
  addedAt      DateTime       @default(now())
  collection   FeedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, videoId])
  @@index([videoId])
}

// ─── Combat Intelligence Engine ─────────────────────────────────────────────
// The single systems every engagement mechanic fans into. The resolution
// pipeline (src/lib/intelligence/resolve.ts) is the only writer of reputation +
// pick stats; these tables are the durable record it and future sources emit to.

/// Append-only reputation ledger. `User.reputation` is the running total; this
/// explains every point so the score is auditable and recomputable. ONE score,
/// many sources (correct picks now; forum upvotes, verified roles, streaks later).
model ReputationEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // "pick_correct" | "pick_streak" | "forum_upvote" | …
  refType   String? // "fight" | "post" | …
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum NotificationType {
  PICK_RESULT
  CARD_EARNED
  REP_MILESTONE
  FIGHT_ANNOUNCED
  EVENT_LIVE
  FOLLOW
  COMMUNITY_REPLY
  BATTLE_RESULT
  BATTLE_MATCHED // an opponent took the other side — the room is live
  /// Someone challenged YOU by name, before you had picked the bout.
  ///
  /// Distinct from BATTLE_MATCHED because it is the only battle notification
  /// that is a REQUEST rather than a report: it needs an action from the
  /// recipient (make the opposite call) and it is the whole point of the
  /// "challenge a friend" flow — the friend has usually not picked yet, which
  /// is exactly why you are inviting them.
  BATTLE_INVITE
  BATTLE_REPLY // your rival spoke in the battle room
  STREAK_REMINDER // your daily visit streak is alive but not yet extended today
  GYM_REVIEW // a gym you follow (or own) received a review
  IDENTITY_VERIFICATION // your professional identity review moved (submitted/approved/declined)
  // ── Gym posts ────────────────────────────────────────────────────────────
  // Three types, not one, because they answer different questions and a user
  // mutes them as a group ("your gym") via CATEGORY_OF in lib/push/policy.
  // A reply and a reaction collapsed into one type would make the wording
  // generic, and generic wording is what makes a notification ignorable.
  GYM_POST_REPLY // someone commented on, replied to, or mentioned you under a gym post
  GYM_POST_REACTION // someone reacted to your gym post or comment
  GYM_POST_SHARE // someone shared your gym post
  DIRECT_MESSAGE // someone sent you a private message
  /// Staff moved a feedback item you filed (planned / in progress / shipped).
  ///
  /// A distinct type rather than SYSTEM so it can be muted as its own thing —
  /// and so it can never be confused with the upvote notification this feature
  /// deliberately does NOT send. One per status change; none per vote.
  FEEDBACK_STATUS
  SYSTEM
}

/// Personal, user-targeted notifications (distinct from /api/notifications, which
/// is a computed public content ticker). Written by notify() from any subsystem.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  url       String?
  icon      String? // optional emoji key for the UI
  // Idempotency for SCHEDULED notifications (Return Engine): e.g.
  // "event_soon:<eventId>". Null for one-off notifications (pick results). The
  // unique guarantees a given reminder is delivered to a user at most once, so
  // the scheduler can re-run safely and use createMany(skipDuplicates).
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  // The scheduler looks rows up by dedupeKey ALONE (which of this batch already
  // existed?), and the composite above cannot serve that — its leading column is
  // userId. Measured as a Seq Scan: harmless at 500 rows, a full table scan per
  // event per cron tick once this table has a year of history in it.
  @@index([dedupeKey])
}

/// A promotion company that hosts events on the platform.
///
/// Separate from the `Promotion` registry model, which is a CATALOGUE entry
/// (UFC, ONE, Matchroom) used to attribute scraped events. This is an ACCOUNT:
/// somebody signed up, proved who they are, and can publish. A registry
/// promotion may exist for decades with no account behind it, and an account
/// may exist for a regional promoter with no registry entry — so they are two
/// different things and conflating them would mean granting publishing rights
/// to a catalogue row.
model PromoterOrg {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  logoUrl   String?
  /// The account that controls this organisation. Null until a claim is
  /// approved — see lib/promoter/verification, which requires BOTH this and
  /// `verified` before granting anything.
  ownerId   String?
  owner     User?   @relation("PromoterOrgOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Staff-set. Alone it grants nothing.
  verified  Boolean @default(false)
  /// Withdrawal of the hosting right. Outranks `verified` in the derivation, so
  /// suspending somebody is one column rather than two.
  suspendedAt DateTime?

  claims PromoterClaim[]
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// An application to host events as a given organisation.
model PromoterClaim {
  id            String      @id @default(cuid())
  promoterOrgId String
  promoterOrg   PromoterOrg @relation(fields: [promoterOrgId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// pending | approved | rejected | info_requested — the same vocabulary
  /// GymClaim uses, so lib/promoter/verification reads them identically.
  status        String      @default("pending")
  /// What the applicant said. Evidence documents ride the existing private
  /// evidence store (lib/evidence), never this table.
  note          String?
  reviewedById  String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One open application per person per organisation.
  @@unique([promoterOrgId, userId])
  @@index([status])
}

enum ActivityType {
  PICK_MADE
  PICK_CHANGED
  PICK_CORRECT
  PICK_MISSED
  CARD_EARNED
  REP_MILESTONE
  FOLLOW
  THREAD_CREATED
  POST_CREATED
  CHALLENGE_SENT
  CHALLENGE_ACCEPTED
  BATTLE_WON
  BADGE_EARNED
}

/// One shared activity stream. Everything a user does that's worth surfacing
/// emits here; the homepage/profile feeds read from it.
///
/// EXTENDING: a new activity kind is a value on ActivityType plus an emitter
/// call — never a new table and never a new column. `title` is the rendered
/// sentence and `url` is where it points, both resolved at WRITE time, so a
/// feed read is one indexed query with no joins and no per-row lookups however
/// many kinds exist. `meta` carries anything a future renderer might want
/// (deltas, opponent handles) without a migration.
///
/// The cost of that shape is that `title` is a snapshot: if a user later
/// changes their display name, sentences already written keep the old one. That
/// is the right trade for a feed — it is a log of what happened, and rewriting
/// history to match a renamed account would be worse.
model Activity {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  title     String
  url       String?
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum CardRarity {
  BASE
  RARE
  EPIC
  CHAMPION
  LEGEND
}

/// A collectible fighter card a user has EARNED (the collectible-infrastructure
/// spine — no gambling). Rarity is derived from the bout's stakes. Marketplace/
/// packs build on this ownership record later.
model CardAward {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterId String
  fighter   Fighter    @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  rarity    CardRarity
  reason    String // "correct_pick" | "streak_milestone" | …
  fightId   String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([fighterId])
}

// ─── Prediction Battles (PvP) ───────────────────────────────────────────────
// Every prediction can create an adversary: two users who picked OPPOSITE corners
// on the same bout are paired into a Battle. The fight itself is the referee — the
// resolution engine reads each side's graded FightPick.correct and declares the
// winner. No moderators, no voting. Battle stakes layer onto the ONE reputation
// score; Rivalry persists head-to-head history for future rival pages / ladders.

enum BattleState {
  WAITING // challenger in, awaiting an opponent
  ACTIVE // both sides matched
  RESOLVED // fight decided, winner set (or draw)
  CANCELLED // withdrawn
  EXPIRED // fight passed with no opponent
}

model Battle {
  id      String @id @default(cuid())
  fightId String
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  challengerId         String
  challenger           User         @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  // Snapshots for display only — the WINNER is decided from the graded FightPick,
  // so editing a pick after matching is handled correctly.
  challengerCorner     String
  challengerMethod     FightMethod?
  challengerConfidence Int?

  opponentId         String?
  opponent           User?        @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  opponentCorner     String?
  opponentMethod     FightMethod?
  opponentConfidence Int?

  state          BattleState  @default(WAITING)
  winnerId       String? // User.id, or null for a draw/void
  loserId        String?
  resolvedSource String? // "fight_result"
  messageCount   Int          @default(0)
  /// The battle's PRIVATE room (visibility="battle"), provisioned on first open.
  room           ForumThread?
  /// The DM cards that reference this battle. A challenge is delivered as a
  /// message, so this is how the card finds its live state.
  messages       DirectMessage[]

  createdAt  DateTime  @default(now())
  matchedAt  DateTime?
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt
  // At most one OPEN battle per challenger per fight is enforced in the pairing
  // transaction (a partial unique isn't expressible in Prisma).

  @@index([fightId, state])
  @@index([challengerId, state])
  @@index([opponentId, state])
}

/// Persisted head-to-head between two users (never computed per-request). The pair
/// is stored canonically with userAId < userBId so it is unique and O(1) to look up.
model Rivalry {
  id                  String   @id @default(cuid())
  userAId             String
  userA               User     @relation("RivalryA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId             String
  userB               User     @relation("RivalryB", fields: [userBId], references: [id], onDelete: Cascade)
  aWins               Int      @default(0) // battles userA won
  bWins               Int      @default(0)
  draws               Int      @default(0)
  currentStreakUserId String? // who is on the active win streak
  currentStreak       Int      @default(0)
  bestStreakUserId    String?
  bestStreak          Int      @default(0)
  totalMessages       Int      @default(0)
  firstBattleAt       DateTime @default(now())
  lastBattleAt        DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ─── Analytics (first-party, cookieless) ────────────────────────────────────
// The innovation-accounting instrument. First-party only — NO third-party
// scripts, NO tracking cookie (preserving the documented privacy posture).
// Signed-in events carry userId (the north-star audience is registered
// predictors); anonymous events are recorded with no identity, for aggregate
// volume only. Append-only; never blocks a request (recordEvent swallows errors).
model AnalyticsEvent {
  id     String   @id @default(cuid())
  name   String // allow-listed event name (see src/lib/analytics.ts)
  userId String? // set when signed in; no anonymous cross-session id
  path   String? // route, for pageviews
  props  Json?
  ts     DateTime @default(now())

  @@index([name, ts])
  @@index([userId, ts])
}

// ═══════════════════════════════════════════════════════════════════════════
//  COMMUNITY MAP — gyms, people, presence
//
//  The Location pillar started as an event map. These models turn it into a
//  network: places people belong to, people who opt in to being seen, and a
//  lightweight presence signal that says who is actually there right now.
//
//  Three rules run through all of it:
//
//   1. NOBODY IS ON THE MAP BY DEFAULT. MapVisibility defaults to HIDDEN and
//      every people-layer query filters on it server-side. A UI toggle is not
//      a privacy control.
//   2. WE NEVER STORE A USER'S GPS POSITION. A person's map point is the
//      CENTRE OF A CITY THEY CHOSE, resolved through the same gazetteer the
//      events use. That is enough to find training partners and not enough to
//      find someone's house — and it cannot leak precision we never held.
//   3. PRESENCE EXPIRES. A check-in is a few hours of "I'm here", not a
//      permanent location history. Expired rows stop matching every query.
// ═══════════════════════════════════════════════════════════════════════════

/// Who may see a user on the map. HIDDEN is the default and the fallback for
/// any value the server does not recognise.
enum MapVisibility {
  HIDDEN
  PUBLIC
  FOLLOWERS /// people they follow back — the "friends only" setting
  GYM_MEMBERS /// members of a gym they belong to
  EVENTS_ONLY /// only while checked in to an event
}

/// A training location: gym, academy, club room, boxing gym, wrestling room.
/// First-class and claimable — the combat-sports equivalent of a Google
/// Business Profile.
model Gym {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  logoUrl String?
  heroUrl String?

  /// Location. `latitude`/`longitude` are real columns here (unlike Event,
  /// which is still gazetteer-resolved) because a gym IS an address — it is
  /// the thing being looked up, and "somewhere in this city" is not good
  /// enough to drive to. Null until geocoded; the map lists those separately
  /// rather than guessing.
  address     String?
  city        String?
  region      String?
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?

  /// What is actually taught here — drives the discipline filter.
  disciplines String[]

  website   String?
  instagram String?
  facebook  String?
  youtube   String?
  tiktok    String?
  phone     String?
  email     String?
  /// Free text ("Mon–Fri 6am–9pm · Open mat Sat 11am"). Structured opening
  /// hours are a real modelling job and this is honest until then.
  hoursNote String?

  /// Set by a reviewed GymClaim. Never by the owner directly.
  verified    Boolean @default(false)
  ownerId     String?
  owner       User?   @relation("GymOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Denormalised so a map pin never counts rows.
  memberCount Int     @default(0)
  /// Denormalised review aggregate — same reasoning as memberCount: a map pin,
  /// a list row and a search result show the rating without loading a single
  /// review row. Recomputed in a transaction whenever a review changes.
  ratingAvg   Float? // 1..5, null until the first review
  ratingCount Int     @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  GymMember[]
  claims   GymClaim[]
  checkIns CheckIn[]
  photos   GymPhoto[]
  reviews  GymReview[]
  posts    GymPost[]

  @@index([countryCode])
  @@index([latitude, longitude])
}

/// Membership. `isHome` is the one a fighter calls their home gym — at most
/// one per user, enforced in the service layer.
model GymMember {
  id     String  @id @default(cuid())
  gymId  String
  gym    Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// member | coach | owner
  role   String  @default("member")
  isHome Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([gymId, userId])
  @@index([userId, isHome])
}

/// Ownership claim over a gym page. Mirrors FighterClaim's shape deliberately:
/// same review vocabulary, same admin habits, no second concept to learn.
model GymClaim {
  id         String @id @default(cuid())
  gymId      String
  gym        Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  claimantId String
  claimant   User   @relation("GymClaimsMade", fields: [claimantId], references: [id], onDelete: Cascade)

  /// pending | approved | rejected | info_requested
  status   String  @default("pending")
  /// How they say they can prove it (role, website email, socials).
  evidence String?
  note     String?

  // ── Uploaded proof (business licence, utility bill, signage photo) ────────
  // Column-for-column the same shape as FighterClaim so ONE evidence pipeline
  // (src/lib/evidence/*) serves both: private bucket, virus scan, retention
  // deadline, audited deletion. These bytes are NEVER public and have no URL —
  // they are streamed by an authorised reader only.
  evidenceStorageKey      String? // opaque object key; never returned to clients
  evidenceStorageProvider String? // "r2" | "local-private"
  evidenceUploadedAt      DateTime?
  evidenceDeleteAfter     DateTime? // retention deadline; cleanup job deletes past this
  evidenceDeletedAt       DateTime?
  evidenceDeletionStatus  String? // null | PENDING | DELETED | FAILED
  evidenceDeletionError   String?
  evidenceScanStatus      String? // PENDING | CLEAN | INFECTED | SKIPPED
  evidenceContentType     String?
  evidenceByteSize        Int?

  reviewerId String?
  reviewer   User?     @relation("GymClaimsReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([claimantId])
  @@index([evidenceDeleteAfter])
}

/// "I'm here." Presence, not location history — `expiresAt` is what keeps this
/// from becoming a tracking log, and every read filters on it.
model CheckIn {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId   String?
  gym     Gym?    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Optional short status ("open mat", "watching the prelims").
  note    String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([gymId, expiresAt])
  @@index([eventId, expiresAt])
  @@index([userId, expiresAt])
}

/// The user→user social graph. Nothing in the schema modelled "I follow this
/// person" — favourites covered fighters, promotions and events only — so
/// "Friends Only" visibility had nothing to resolve against and the Following
/// pillar had no people in it. One row per direction; mutual follow is both.
/// ── Direct messages ────────────────────────────────────────────────────────
///
/// One-to-one only, deliberately. A group thread needs its own membership
/// lifecycle (invite, leave, rename, who-can-add) and a different read model;
/// building the pair case first keeps the schema honest rather than shipping a
/// group table nothing populates. `pairKey` is what makes it 1:1 and safe:
/// the two user ids, sorted and joined, so the SAME two people can only ever
/// have ONE conversation no matter who opens it first, enforced by the database
/// rather than by a check-then-create race (see CLAUDE.md rule 4).
model Conversation {
  id String @id @default(cuid())
  /// "<lowerId>:<higherId>" — sorted, so it is orientation-independent.
  pairKey String @unique

  createdAt DateTime @default(now())
  /// Denormalised so the inbox can order without touching the message table.
  /// Written in the same transaction as the message it describes.
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages DirectMessage[]

  @@index([lastMessageAt])
}

/// A participant, and their read position. `lastReadAt` is a WATERMARK rather
/// than a per-message read flag: unread is then a count of messages newer than
/// it, which needs no write per message and cannot drift out of sync with the
/// thread.
model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?
  /// Last moment this member's CLIENT fetched this conversation's messages —
  /// their inbox poll or their thread poll. Distinct from `lastReadAt`, which
  /// only moves while the thread is actually open.
  ///
  /// The gap between the two is what makes ✓✓ Delivered honest and different
  /// from ✓✓ Read: their device has the bytes, their eyes have not been on it.
  /// Without this column a product either shows no delivered state or fakes one
  /// the moment the sender's own request returns — which is a claim about the
  /// recipient made purely from the sender's side.
  lastDeliveredAt DateTime?
  /// Leaving hides the thread without destroying the other person's copy of the
  /// conversation — a message is shared history, not one user's row.
  archivedAt DateTime?
  /// Last moment this member was composing. A TIMESTAMP, not a boolean, so the
  /// signal expires on its own: a reader who types a word and closes the tab
  /// leaves no "still typing…" stuck on the other side forever, because the
  /// consumer only believes a value a few seconds old (TYPING_TTL_MS in
  /// lib/messages/repo). There is nothing to clean up and no sweep to schedule.
  typingAt   DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

/// What a message IS. A discriminator, not a content column.
///
/// Added so a challenge can live INSIDE a conversation rather than in a
/// parallel feature. A challenge that exists on its own screen makes the user
/// jump between unrelated parts of the app; a challenge that is a message makes
/// the flow challenge -> discussion -> predictions -> event -> result one
/// continuous thread with the person it concerns.
///
/// This is also the seam every future rich message rides on — an image, a voice
/// note, a shared event — so none of those needs a schema rewrite. Each one is
/// a member here plus a nullable reference, never a JSON blob: a blob cannot be
/// joined, cannot be constrained, and cannot cascade when the thing it points at
/// is removed.
enum DirectMessageKind {
  TEXT
  CHALLENGE
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  /// ALWAYS a readable sentence, even for a rich message.
  ///
  /// The card is an ENRICHMENT layered on top, never the only copy of what was
  /// said. So a message still reads in the inbox preview, in a push
  /// notification, to a screen reader, and on the day the battle it referenced
  /// is gone — see the SetNull below.
  body String @db.Text

  kind DirectMessageKind @default(TEXT)

  /// Set when kind = CHALLENGE.
  ///
  /// SetNull, not Cascade: deleting a battle must not delete a message somebody
  /// sent. The row degrades to its `body` sentence and the conversation stays
  /// intact, which is the whole reason `body` is always populated.
  battleId String?
  battle   Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The inbox and the thread both read newest-first within a conversation.
  @@index([conversationId, createdAt])

  /// Structured entities for `body` — see lib/entities.
  ///
  /// NULL means legacy content written before this existed, and it stays
  /// readable: the renderer falls back to the @handle parser. There is no
  /// backfill and there does not need to be one.
  ///
  /// Json rather than a join table on purpose. Entities are read on EVERY
  /// render of the row they annotate and are never queried independently — a
  /// table would add a join to every feed page to answer a question nobody
  /// asks. The trade is that the database cannot enforce the shape, which is
  /// why sanitizeEntities treats this column as untrusted input on the way out.
  entities Json?

}

model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─── Media assets ───────────────────────────────────────────────────────────

/// Where an asset is in the upload lifecycle. Only READY may be served.
enum MediaStatus {
  /// Bytes accepted into TEMP storage. Nothing has looked at them yet.
  PENDING
  /// Handed to the malware scanner.
  SCANNING
  /// Scan passed; deriving variants and stripping metadata.
  PROCESSING
  /// Variants written to PUBLIC storage. The only servable state.
  READY
  /// Scan said INFECTED, or validation refused it. Bytes are in QUARANTINE.
  REJECTED
  /// The scan or the processing step failed for a reason that is not the
  /// file's fault (scanner down, decoder error). Retryable by an operator;
  /// distinct from REJECTED so "we could not check it" is never confused with
  /// "it is malicious".
  FAILED
  /// Soft-deleted. The row survives so reference counting and audit hold; the
  /// bytes are removed by the cleanup job.
  DELETED
}

/// ONE reusable media asset. Deliberately knows NOTHING about gyms.
///
/// Every future consumer — gym posts, fighter photos, promotion banners, event
/// posters, coach galleries, article covers — points AT this row rather than
/// owning its own upload table. That is the whole design: one lifecycle, one
/// scanner, one storage layout, one cleanup job. A second media table is the
/// thing this model exists to prevent.
///
/// `ownerId` is WHO UPLOADED IT, not what it belongs to. Attachment is the
/// consumer's job (a join row on their side), which is what keeps this generic
/// and what makes reference counting meaningful.
model MediaAsset {
  id     String      @id @default(cuid())
  status MediaStatus @default(PENDING)

  /// SHA-256 of the ORIGINAL bytes. The dedupe key: an identical file uploaded
  /// twice reuses this row and bumps refCount rather than storing it again.
  /// Unique, so the database enforces it under concurrency instead of a
  /// check-then-insert race (CLAUDE.md rule 4).
  sha256 String @unique

  /// Determined by SIGNATURE sniffing, never the client's Content-Type.
  mime   String
  bytes  Int
  width  Int @default(0)
  height Int @default(0)

  /// Opaque storage keys. NEVER returned to a client — a URL is minted for the
  /// public variants only, and temp/quarantine have no URL at all.
  tempKey       String?
  quarantineKey String?
  /// Base key under the public prefix; variants hang off it.
  publicKey     String?

  /// Rendered sizes: { thumb, small, medium, large } → public URLs. JSON rather
  /// than columns because the variant SET will change (AVIF, video posters) and
  /// a column per size is a migration every time.
  variants Json?
  /// Tiny base64 LQIP so a grid has no layout shift before the image lands.
  blurhash String?

  /// Scan outcome, kept for the audit trail. Never shown to an uploader.
  scanVerdict   String?
  scanProvider  String?
  scanSignature String?
  scannedAt     DateTime?

  /// WHO UPLOADED IT. Not what it belongs to.
  ownerId String?
  owner   User?   @relation("MediaUploader", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Free-form origin tag ("gym-post", "fighter-photo"), for cleanup policy and
  /// analytics only. NEVER an authorization input — permission is the
  /// consumer's job, and a string on the asset must not become a capability.
  sourceType String?

  /// How many live references point at this asset. Reaches zero → the cleanup
  /// job may remove the bytes. Never decremented below zero.
  refCount Int @default(0)

  /// Screen-reader description. Required before an asset is shown publicly;
  /// enforced by the consumer, since only it knows the context.
  alt String?

  /// TEMP rows expire. A PENDING asset older than this is abandoned — a browser
  /// that closed mid-upload — and the cleanup job removes it.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The consumers that hold a reference. The asset does not know what a gym
  /// post IS — this is Prisma's back-relation, not knowledge: the join row lives
  /// on the CONSUMER's side, which is what keeps this model generic. Every
  /// future consumer adds its own join table and its own line here.
  gymPostAttachments GymPostMedia[]

  /// Cleanup scans by state + age; the feed reads READY by recency.
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([ownerId, createdAt])
}

/// A gallery image on a gym page. Stores BOTH the full and thumb URLs the image
/// pipeline returns, plus the intrinsic dimensions — a gallery that renders
/// without width/height reflows the whole page as each image lands.
model GymPhoto {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  url      String
  thumbUrl String
  width    Int       @default(0)
  height   Int       @default(0)
  /// Shown under the image in the viewer.
  caption  String?
  /// Screen-reader description. Distinct from caption on purpose: a caption is
  /// editorial ("Saturday open mat"), alt text describes what is IN the frame
  /// for someone who cannot see it. Using one for both fails whichever reader
  /// you did not have in mind.
  alt      String?
  /// Photo credit, when a gym is publishing someone else's work.
  credit   String?
  takenAt  DateTime?

  /// Manual ordering; ties break on createdAt.
  sortOrder Int @default(0)

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([gymId, sortOrder])
}

/// A fighter's review of a gym. One per user per gym (upserted, editable, soft-
/// deleted). Category ratings (coaching/facilities/atmosphere/cleanliness/value)
/// are optional and produce far richer data than a single star — a gym can be
/// elite coaching in a rough room, and the summary shows exactly that. The
/// author's membership is SNAPSHOT at review time (verifiedMember/authorRole) so
/// a later membership change can't retroactively rewrite the trust signal on an
/// old review.
model GymReview {
  id       String @id @default(cuid())
  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("GymReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Overall 1..5. The headline number.
  overall     Int
  /// Optional category ratings, 1..5. Null = "didn't rate this".
  coaching    Int?
  facilities  Int?
  atmosphere  Int?
  cleanliness Int?
  value       Int?

  title       String?
  body        String   @db.Text
  recommended Boolean  @default(true)
  /// beginner | intermediate | advanced | professional
  skillLevel  String?
  /// What this author trains here — subset of the gym's disciplines.
  disciplines String[]

  /// Trust snapshot at review time.
  verifiedMember Boolean @default(false)
  /// member | coach | owner — null when the author was not a recorded member.
  authorRole     String?

  /// Denormalised helpful-vote tally, kept in sync with GymReviewVote.
  helpfulCount Int      @default(0)
  edited       Boolean  @default(false)
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  votes GymReviewVote[]

  // One review per user per gym.
  @@unique([gymId, authorId])
  // Ranked list: a gym's live reviews, best-supported first.
  @@index([gymId, deleted, helpfulCount])
  @@index([authorId])
}

/// A "helpful" vote on a review. Mirrors ForumReaction: one row per user per
/// review, the denormalised count lives on GymReview.helpfulCount.
model GymReviewVote {
  reviewId  String
  review    GymReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([reviewId, userId])
  @@index([reviewId])
}

// ─── Gym posts ──────────────────────────────────────────────────────────────
//
// The social layer on top of the media lifecycle. Five models, and the shape of
// all five is decided by one rule: a post never learns where bytes live.
//
// GymPost ─┬─ GymPostMedia ──→ MediaAsset   (the ONLY link to storage)
//          ├─ GymPostReaction
//          └─ GymPostComment ─── GymPostCommentReaction
//
// There is no url, key, bucket, filename, width, height, mime or variant column
// anywhere below. Those exist exactly once, on MediaAsset. A caption and alt
// text DO live on the join row and that is deliberate — see GymPostMedia.

/// Who may read a post. Evaluated against the GymPost's own gym and author,
/// NEVER against the attached asset's uploader (see lib/gym-posts/visibility).
enum GymPostVisibility {
  /// Anyone, signed in or not. The default and the one that feeds discovery.
  PUBLIC
  /// Members of the gym (plus its owner and staff).
  MEMBERS
  /// The author, the gym owner, and staff. A draft, or something raised
  /// privately with the gym.
  PRIVATE
}

/// A post on a gym's feed.
///
/// `gymId` is the SUBJECT (whose page this appears on) and `authorId` is the
/// PRINCIPAL (who wrote it). Both are needed: permission questions are answered
/// from the pair, and collapsing them into one column is how "the gym owner can
/// edit a member's words" becomes indistinguishable from "the author can edit
/// their own".
model GymPost {
  id       String @id @default(cuid())
  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("GymPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// The text. Optional in the sense that a post may be media-only, but a post
  /// with neither text nor media is refused in the service layer.
  body       String            @db.Text
  visibility GymPostVisibility @default(PUBLIC)
  /// The gym's owner can pin one post to the top of its own feed.
  pinned     Boolean           @default(false)

  // ── Denormalised engagement ──────────────────────────────────────────────
  // Counted columns rather than _count on every read: the feed ranks on these,
  // and a ranking function that triggers a COUNT per row per page is the query
  // that falls over first. Recomputed (never blind-incremented) wherever a race
  // can drift them — the same lesson ForumThread.reactionCount already learned.
  commentCount  Int @default(0)
  reactionCount Int @default(0)
  shareCount    Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Set the first time the body or the attachments change. Distinct from
  /// updatedAt, which moves whenever a counter does — an "edited" badge driven
  /// by updatedAt would appear the moment somebody else liked the post.
  editedAt  DateTime?

  // ── Soft delete ──────────────────────────────────────────────────────────
  // ONE nullable timestamp is the read filter, so no query can accidentally
  // check the author-deleted flag and forget the moderator-hidden one. WHY it
  // was removed is carried alongside rather than in a second timestamp: the
  // reader treats them identically, the operator does not.
  deletedAt     DateTime?
  /// Who removed it. Null when the row is live, or when the actor is gone.
  deletedById   String?
  deletedBy     User?     @relation("GymPostRemover", fields: [deletedById], references: [id], onDelete: SetNull)
  /// "author" | "moderation". Same outcome for a reader, completely different
  /// operational meaning — one is a person changing their mind, the other is an
  /// enforcement action that has to be reviewable.
  deletedReason String?

  media     GymPostMedia[]
  comments  GymPostComment[]
  reactions GymPostReaction[]

  /// The feed's hot path: live posts for one gym, newest first. deletedAt leads
  /// the sort keys because every single read filters on it.
  @@index([gymId, deletedAt, createdAt])
  /// The cross-gym feed: everything live, newest first, keyset-paginated.
  @@index([deletedAt, createdAt])
  /// "Posts by this member" — a profile surface, and the cleanup path when an
  /// account is tombstoned.
  @@index([authorId, createdAt])

  /// Structured entities for `body` — see lib/entities.
  ///
  /// NULL means legacy content written before this existed, and it stays
  /// readable: the renderer falls back to the @handle parser. There is no
  /// backfill and there does not need to be one.
  ///
  /// Json rather than a join table on purpose. Entities are read on EVERY
  /// render of the row they annotate and are never queried independently — a
  /// table would add a join to every feed page to answer a question nobody
  /// asks. The trade is that the database cannot enforce the shape, which is
  /// why sanitizeEntities treats this column as untrusted input on the way out.
  entities Json?

}

/// One attached asset, in one position, on one post.
///
/// This row IS the reference that MediaAsset.refCount counts. Creating it takes
/// a reference; deleting it releases one. That is the entire contract, and it is
/// why attachment lives here rather than as an array column on GymPost — an
/// array cannot be a join, and a join is what makes reference counting mean
/// something under concurrency.
///
/// `alt` and `caption` are on the JOIN, not on the asset, and that is the
/// interesting call: the same photo attached to two posts describes two
/// different things in context, and alt text that is right for one is wrong for
/// the other. Storing it on the asset would make the second post inherit the
/// first post's words.
model GymPostMedia {
  id     String  @id @default(cuid())
  postId String
  post   GymPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// The ONLY pointer at storage in this entire domain.
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  /// Display order within the carousel. Ties break on id.
  sortOrder Int     @default(0)
  /// Screen-reader description, in THIS post's context.
  alt       String?
  /// Editorial text shown under the image. Never a substitute for alt.
  caption   String?

  createdAt DateTime @default(now())

  /// The same asset twice on one post would double-count the reference and show
  /// the picture twice. Enforced by the database, not by a check-then-insert
  /// (CLAUDE.md rule 4).
  @@unique([postId, assetId])
  @@index([postId, sortOrder])
  /// "Is this asset still referenced?" — read by cleanup and by detach.
  @@index([assetId])
}

/// A reaction on a post. One row per (post, user, type), exactly like
/// ForumReaction — same vocabulary, same toggle semantics, nothing new to learn.
model GymPostReaction {
  id     String  @id @default(cuid())
  postId String
  post   GymPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// like | fire | respect | laugh — see lib/gym-posts/types.
  type   String  @default("like")

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId, createdAt])
}

/// A comment. One level of nesting via `parentId` — a reply to a comment, not a
/// tree. Deeper threading is a rendering problem the forum already solved badly
/// once; a flat list with one reply level is what a feed actually reads as.
model GymPostComment {
  id       String  @id @default(cuid())
  postId   String
  post     GymPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User    @relation("GymPostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String @db.Text

  /// The comment this replies to. Null for a top-level comment. Self-relation
  /// with NoAction: deleting a parent must not cascade away its replies, which
  /// are other people's words — the parent soft-deletes instead.
  parentId String?
  parent   GymPostComment?  @relation("GymPostCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  GymPostComment[] @relation("GymPostCommentReplies")

  reactionCount Int @default(0)

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  /// Same soft-delete contract as GymPost, for the same reason: a hard delete
  /// tears the reply chain and destroys the evidence for an appeal.
  deletedAt     DateTime?
  deletedReason String?

  reactions GymPostCommentReaction[]

  /// A comment thread reads oldest-first within a post, keyset-paginated.
  @@index([postId, deletedAt, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])

  /// Structured entities for `body` — see lib/entities.
  ///
  /// NULL means legacy content written before this existed, and it stays
  /// readable: the renderer falls back to the @handle parser. There is no
  /// backfill and there does not need to be one.
  ///
  /// Json rather than a join table on purpose. Entities are read on EVERY
  /// render of the row they annotate and are never queried independently — a
  /// table would add a join to every feed page to answer a question nobody
  /// asks. The trade is that the database cannot enforce the shape, which is
  /// why sanitizeEntities treats this column as untrusted input on the way out.
  entities Json?

}

model GymPostCommentReaction {
  id        String         @id @default(cuid())
  commentId String
  comment   GymPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String         @default("like")

  createdAt DateTime @default(now())

  @@unique([commentId, userId, type])
  @@index([commentId])
}

/// A browser's Web Push endpoint. One row per DEVICE, not per user — a person
/// with a phone and a laptop gets both, and revoking one must not silence the
/// other.
///
/// `endpoint` is unique: re-subscribing the same browser updates the keys
/// rather than accumulating dead rows. `failedCount` lets delivery prune
/// endpoints the push service has permanently rejected (410/404) instead of
/// retrying them forever.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  /// Client public key + auth secret from the browser's subscription.
  p256dh   String
  auth     String

  userAgent   String?
  failedCount Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ─── Results Intelligence ─────────────────────────────────────────────────
// Evidence-based verification, so a bout's result is explainable and never
// settled on a guess. Settlement reads Fight.result, and the ONLY thing that may
// write it from this subsystem is a candidate an operator (or a high-confidence
// consensus) has moved to VERIFIED. See src/lib/results/*.

enum EvidenceSourceKind {
  WIKIPEDIA
  OFFICIAL
  MAJOR
  TRADE
  AGGREGATOR
  UNKNOWN
  OPERATOR
}

/// One source's reading of one bout. Append-only, and never authoritative.
model ResultEvidence {
  id      String @id @default(cuid())
  fightId String
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  sourceKind EvidenceSourceKind
  /// Publisher name for the operator queue ("Boxing News 24").
  sourceName String
  sourceUrl  String?
  headline   String?
  /// The text the reading came from, kept so an operator can judge it without
  /// re-fetching a page that may since have been edited.
  snippet    String? @db.Text

  /// What we read. `outcome` is "WIN" | "DRAW" | "NO_CONTEST"; winnerCorner is
  /// "RED" | "BLUE" and null for a draw or no contest.
  outcome      String
  winnerCorner String?
  method       FightMethod?
  roundEnded   Int?
  /// Extraction quality (0..1) BEFORE source reliability is applied.
  quality      Float

  /// When the SOURCE published — not when we read it. Late reports carry detail.
  observedAt DateTime?
  createdAt  DateTime @default(now())

  /// One reading per source article per bout, so re-running the pass is a no-op
  /// rather than a way to manufacture agreement with yourself.
  @@unique([fightId, sourceUrl])
  @@index([fightId, createdAt])
}

enum ResultCandidateStatus {
  /// Stored, too weak to act on.
  INCONCLUSIVE
  /// Plausible; a human must confirm before it can settle anything.
  PENDING_REVIEW
  /// Sources disagree about the WINNER, or about the method. Always human.
  CONFLICTED
  /// Confirmed. This is the ONLY status that may write Fight.result.
  VERIFIED
  /// A human said no.
  REJECTED
}

/// The single current reading for a bout, derived from its evidence.
model ResultCandidate {
  id      String @id @default(cuid())
  /// One live candidate per bout — a rescore replaces it rather than accumulating.
  fightId String @unique
  fight   Fight  @relation(fields: [fightId], references: [id], onDelete: Cascade)

  outcome      String
  winnerCorner String?
  method       FightMethod?
  roundEnded   Int?

  confidence Float
  status     ResultCandidateStatus @default(PENDING_REVIEW)
  /// Distinct independent voices for and against this reading.
  agreeing    Int @default(0)
  disagreeing Int @default(0)
  /// Why we believe this — rendered verbatim in the operator queue.
  reasons     Json

  reviewedById String?
  reviewedBy   User?     @relation("ResultReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  /// Set when this candidate actually wrote Fight.result, so a re-run cannot
  /// settle the same bout twice.
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The operator queue reads by status, newest first.
  @@index([status, updatedAt])
}

// ─── Public feedback board ──────────────────────────────────────────────────

/// A product idea, request or bug report, submitted by a member and voted on
/// publicly.
///
/// PUBLIC BY CONSTRUCTION. This is a board, not a support ticket queue: the
/// value is that people see each other's ideas and can say "that one, please".
/// The only per-row visibility is `hiddenAt`, which is a moderation action.
///
/// ── Why the author never controls `status` ────────────────────────────────
/// "Planned" and "In progress" are promises the product is making, not claims
/// the author gets to publish about their own request. Only staff transition
/// it, and the service refuses any other caller — see lib/feedback.
model FeedbackItem {
  id String @id @default(cuid())

  /// Nullable so a deleted account does not take the board's history with it —
  /// the item survives as an unattributed idea that other people already voted
  /// for. Matches how the rest of the product treats authored public content.
  authorId String?
  author   User?   @relation("FeedbackAuthored", fields: [authorId], references: [id], onDelete: SetNull)

  title String
  body  String @db.Text

  /// IDEA | FEATURE | IMPROVEMENT | BUG
  category String
  /// OPEN | PLANNED | IN_PROGRESS | COMPLETED | DECLINED
  status   String @default("OPEN")

  /// Shown ON the board beside the status — "shipped in the 2.1 map release".
  publicNote String? @db.Text
  /// STAFF ONLY. Never selected by any public query; the service's public
  /// projections list their columns explicitly so this cannot leak by default.
  adminNote  String? @db.Text

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("FeedbackResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Moderation removal. A soft delete, so the audit trail and the votes cast
  /// on it survive the decision — a hard delete would erase the evidence for
  /// why it was removed.
  hiddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes FeedbackVote[]

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([authorId, createdAt])
  @@index([hiddenAt])
}

/// One member, one vote, per item.
///
/// The composite primary key IS the constraint — the same shape GymReviewVote
/// uses. A duplicate vote is a database error rather than something the
/// application has to remember to check, which is what makes the concurrent
/// case safe: two simultaneous requests cannot both insert.
model FeedbackVote {
  feedbackId String
  feedback   FeedbackItem @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@id([feedbackId, userId])
  @@index([feedbackId])
  @@index([userId])
}
