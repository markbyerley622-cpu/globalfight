# ── GlobalFight — environment template ─────────────────────────────────────
# Copy to .env for local dev, or paste into Render → Environment.
# NEVER commit a real .env (it is gitignored).

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
# Render → your Postgres instance → "Internal Database URL".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB"
# 64 hex chars. Generate a NEW one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="https://your-app.onrender.com"

# ── Cron auth ──────────────────────────────────────────────────────────────
# Generate a new strong secret; set BOTH to the same value.
# cron-handler.ts accepts either (CRON_SECRET is the Vercel convention).
SCRAPE_CRON_SECRET=""
CRON_SECRET=""

# ── Ingestion gate (the only one) ──────────────────────────────────────────
# Required for ANY scrape fetch, and as of 2026-08-01 the only thing standing in
# front of ingestion: the per-source legal allow-list in
# src/lib/ingestion-registry.ts was removed on the operator's instruction, so
# every wired provider writes when this is "true". The registry entries remain as
# a record of each source's terms — read them; nothing enforces them. Written
# permission is still the right thing to have before production/public use.
ENABLE_SCRAPER="false"
# 3000, not 800: onefc.com refused 199 of 224 event pages with HTTP 429 at the
# faster rate. The client honours a refusal and does not retry, so a too-fast
# throttle costs coverage rather than just politeness.
SCRAPER_RATE_LIMIT_MS="3000"
SCRAPER_MAX_RETRIES="2"
BKFC_CONCURRENCY="3"
BKFC_MAX_PAGES="0"
ONE_CONCURRENCY="3"
ONE_MAX_PAGES="0"
WIKICARD_BATCH="40"
WIKICARD_CONCURRENCY="2"

# ── Licensed data APIs ───────────────────────────────────────────────────────
# Each provider in src/services/providers stays dormant (configured:false → the
# aggregator simply skips it) until its key below is set. No code change is ever
# needed to activate one — paste the key and the daily /api/cron/sync pulls it
# into Fighter/Event/Fight, which is what every page reads. Only properly-licensed
# API sources are wired; ESPN-hidden / Tapology-unofficial / Sportbex were removed
# for compliance (see src/services/providers/registry.ts) — do not re-add them.
#
# LIVE (keys already set in .env):
#   ODDS_API_KEY   — The Odds API. MMA + Boxing moneyline/totals, surfaced on
#                    event/fight pages, market cards and bout-picks.
#                    Get: https://the-odds-api.com  (free tier, then $29/mo)
#   API_SPORTS_KEY — API-Sports MMA v1. Fighters/events/results/records.
#                    Get: https://dashboard.api-football.com/mma  (free 100/day)
ODDS_API_KEY=""
API_SPORTS_KEY=""
#
# BOXING — Boxing Data API (RapidAPI, by BennyG). Records, physical stats, titles,
#   future schedules → feeds the BOXING sport across fighters/rankings/p4p/events.
#   Get the key: https://rapidapi.com/bengroves1993/api/boxing-data-api
#     RapidAPI → subscribe (BASIC is free, ~500 req/mo) → copy "X-RapidAPI-Key".
#   Paste it as BOXING_DATA_API_KEY (or set the shared RAPID_API and every
#   RapidAPI-backed provider uses it). The two guards keep a sync inside the free
#   quota — raise them once you upgrade the RapidAPI plan.
BOXING_DATA_API_KEY=""
# RAPID_API=""                 # shared x-rapidapi-key fallback for all RapidAPI sources
# BOXING_DATA_MAX_PAGES="3"    # schedule pages crawled per sync (25 bouts/page)
# BOXING_DATA_MAX_FIGHTERS="24"# full fighter-profile lookups per sync
#
# WRESTLING / JUDO / TAEKWONDO / BOXING / MMA — Data Sports Group.
#   Turns the scrape-only federation sports into a licensed API (real-time scoring,
#   athlete profiles, rankings, medals). Quote-only with a free trial.
#   Get the trial key: https://datasportsgroup.com  → paste as DSG_API_KEY.
DSG_API_KEY=""
# DSG_API_BASE="https://dsg-api.com/api"   # override only if DSG give you a different host
#
# MMA / BOXING — Sportradar (enterprise licence, quote-only; OPTIONAL). Deep
#   UFC + DWCS stats. Per-sport entitlement: set whichever you licence.
#   Buy: https://marketplace.sportradar.com/products/652fc88991cb7d6acdef2532
# SPORTRADAR_MMA_KEY=""
# SPORTRADAR_BOXING_KEY=""
# SPORTRADAR_ACCESS="trial"    # "trial" | "production" — matches your entitlement tier
# SPORTRADAR_DAYS="14"         # forward schedule window pulled per sync

# ── Fighter photos / enrichment ────────────────────────────────────────────
MEDIA_INGESTION_ENABLED="true"
ENRICH_BATCH="30"

# ── Image storage ──────────────────────────────────────────────────────────
# public/headshots is gitignored (225MB of generated black-bg photos), so it is
# NOT deployed. To serve fighter photos in production, upload them to R2/S3 and
# point imageUrl at the CDN (next.config + media-safe already allow **.r2.dev /
# **.public.blob.vercel-storage.com as "own storage").
STORAGE_PROVIDER=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""

# ── Optional ───────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# REDIS_URL=""          # falls back to an in-process cache when unset
# USE_MOCK_DATA="false" # real Postgres is the default

# ── Seed World — single source of truth: SEED_WORLD_MODE ─────────────────────
#   off | (unset) → never seed; leave any existing seed data untouched.
#   demo          → on startup, seed once if the DB has no seed users (idempotent);
#                   also shows the transparent "Demo World" badge + footer.
#   refresh       → wipe + regenerate once per deploy, then behave as demo.
# Populates ~70 marked (@seed.local) users + predictions, discussions, cards,
# notifications, activity. Reset (remove all seed data) via the admin endpoint:
#   POST /api/admin/seed-world/reset  (Authorization: Bearer <SEED_WORLD_ADMIN_TOKEN>)
SEED_WORLD_MODE="off"
# Bearer token for the reset endpoint above.
# SEED_WORLD_ADMIN_TOKEN=""

# ── Location pillar — map basemap ────────────────────────────────────────────
# The /map basemap. Defaults to CARTO's dark raster tiles over OpenStreetMap
# data, attributed in-map as both licences require. Point these at Mapbox, a
# Google raster proxy or a self-hosted style to swap providers without a code
# change. Both are NEXT_PUBLIC_ — they are fetched by the browser.
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap &copy; CARTO"

# ── Transactional email (password reset) ─────────────────────────────────────
# The reset flow is fully built: rate-limited per-IP and per-account,
# enumeration-safe (identical response whether or not the address exists), and
# one-time tokens that expire. The ONLY missing piece is a provider.
#
# Until these are set, production returns 503 for a reset request rather than
# saying "check your inbox" for a mail that was never sent — see
# src/lib/email/send.ts. In development the reset LINK is written to the server
# log instead, so you can test the flow without a provider.
#
# Two implemented providers — pick one. Full trade-offs in src/lib/email/send.ts.
#
# Resend (plain HTTPS, no SDK dependency). EMAIL_FROM must be an address on a
# domain you have verified with them — NOT a gmail.com/outlook.com address,
# their DMARC policy rejects a third party sending as them.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="Combat Reviews <no-reply@yourdomain.com>"
#
# Direct SMTP (Gmail/Outlook/other) — sends as a real mailbox authenticating
# with its own provider, so DMARC doesn't apply. EMAIL_FROM's address must
# match SMTP_USER. Gmail SMTP_PASS is a 16-char App Password (Google Account →
# Security → App Passwords, requires 2-Step Verification), not your login
# password. Capped ~500 sends/day on consumer Gmail.
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS=""
# EMAIL_FROM="you@gmail.com"
#
# Also required for the link in the email to point anywhere real:
# NEXT_PUBLIC_SITE_URL="https://globalfight.onrender.com"

# ── Image uploads (gym logo / hero / gallery, user avatars) ──────────────────
# ALL public media uploads are gated by this ONE flag, and it fails closed.
# The gate exists because there is no malware scanner and no moderation queue
# (see src/lib/ugc-guard.ts) — the app refuses an upload rather than publish a
# file it cannot scan. Gym owners are verified humans but are not a trusted
# binary source, so gym media gets no exemption.
#
# With this unset/false: the uploader shows the server's real 503 reason.
# With it "true": logo, hero and gallery uploads work end-to-end.
UGC_MEDIA_UPLOADS_ENABLED="false"
#
# Where the processed WebP files are stored. First match wins:
#   Vercel Blob → BLOB_READ_WRITE_TOKEN
#   Cloudflare R2 / S3 → R2_* (or S3_*) below
#   neither → public/ on local disk (dev only; Render's disk is ephemeral)
# BLOB_READ_WRITE_TOKEN=""

# ── Identity / ownership evidence storage (PRIVATE bucket) ───────────────────
# Required for fighter claims AND gym-ownership claims. Without it,
# putEvidence() THROWS in production rather than writing an identity document
# to local disk — a deliberate refusal, not a bug. Verified against a real
# S3-compatible endpoint.
#
# This bucket MUST be separate from R2_BUCKET and MUST have no public base URL.
# Both are asserted at boot (src/lib/evidence/config.ts) and the process refuses
# to start otherwise — identity documents must never be publicly addressable.
# The bytes are streamed through an authorised endpoint; they are never linked.
# EVIDENCE_R2_ENDPOINT=""
# EVIDENCE_R2_BUCKET=""
# EVIDENCE_R2_ACCESS_KEY_ID=""
# EVIDENCE_R2_SECRET_ACCESS_KEY=""
# EVIDENCE_R2_REGION="auto"
#
# Fail CLOSED on unscanned documents (no AV provisioned = unopenable) instead of
# the documented default of allowing review with a "NOT scanned" warning:
# EVIDENCE_REQUIRE_SCAN="false"

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Powers push notifications: fight reminders, prediction results, replies.
# Unset = push silently does nothing (in-app notifications still work); it never
# pretends to send, the same posture as email.
#
# Generate a pair once:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL you control.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:support@yourdomain.com"

# ── Legal identity — REQUIRED BEFORE COLLECTING A SINGLE EMAIL ───────────────
# /privacy, /terms and /cookies are rendered from src/lib/privacy-inventory.ts,
# but the CONTROLLER — who you are, where, under whose law — cannot be inferred
# from code and is never invented. Until all seven are set, those pages publish
# placeholder text saying they must not be relied upon, and
# `npm run audit:launch` scores it as a blocker.
#
# Google Play requires a privacy-policy URL that RESOLVES and describes the app,
# so this is a submission blocker, not only a legal one. Sign-up already
# collects an email address.
#
# The three addresses may be the same mailbox — they are separate keys so they
# can be routed differently later without editing the pages.
# LEGAL_ENTITY_NAME=""
# LEGAL_ENTITY_ADDRESS=""
# LEGAL_CONTACT_EMAIL=""
# PRIVACY_CONTACT_EMAIL=""
# COPYRIGHT_CONTACT_EMAIL=""
# LEGAL_JURISDICTION=""
# POLICY_EFFECTIVE_DATE=""

# ── Google Play / Trusted Web Activity ───────────────────────────────────────
# Built into /.well-known/assetlinks.json, which is how Android decides the app
# is allowed to render this site without a URL bar. Unset → that route answers
# 404 deliberately (a malformed statement is worse: Android CACHES the failure,
# so a bad file keeps the URL bar visible after you fix it).
#
# TWA_PACKAGE_NAME is the Android application id and is PERMANENT once
# published. It must match the id in android/twa-manifest.json, which
# `npm run android:manifest` generates from this same variable.
#
# TWA_SHA256_FINGERPRINTS takes BOTH keys, comma-separated: your upload key AND
# the Play App Signing key. Play re-signs uploads with its own key, so the
# fingerprint that verifies in production is NOT the one from your keystore.
# Play Console → Setup → App integrity.
# TWA_PACKAGE_NAME="com.combatreviews.app"
# TWA_SHA256_FINGERPRINTS=""

# ── Prediction-market data — LEAVE OFF FOR A GOOGLE PLAY BUILD ───────────────
# All four are off unless explicitly "true" (fail closed), and they must STAY
# off on any build submitted to Play unless you have taken the gambling
# declaration deliberately.
#
# The app itself stakes no money: picks score points and nothing is wagered.
# Bookmaker ODDS are displayed for information with the 18+/responsible-gambling
# disclosure attached at every surface (src/components/odds-disclosure.tsx), and
# nothing links out to a bookmaker. That posture is what keeps this a sports
# information app rather than a gambling one.
#
# TRADING_LINKS_ENABLED is the line: it emits OUTBOUND links to Polymarket /
# Kalshi, which are real-money venues. Turning it on changes what the app is
# under Play's Real-Money Gambling, Games and Contests policy and requires a
# separate declaration and country allow-list in Play Console.
# MARKET_PRICES_ENABLED="false"
# POLYMARKET_ENABLED="false"
# KALSHI_ENABLED="false"
# TRADING_LINKS_ENABLED="false"

# ── Error reporting ──────────────────────────────────────────────────────────
# Unset = errors are logged locally and go nowhere. A store release with no
# crash signal means the first you hear of a broken build is a one-star review.
# ERROR_REPORT_URL=""
